{
  "$schema": "https://docs.openclaw.ai/gateway/configuration-reference",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${JARVIS_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw-jarvis/workspace",
      "model": {
        "primary": "opencode/space-bunny-free",
        "fallbacks": []
      },
      "utilityModel": "",
      "modelSelectionScope": "session",
      "skipBootstrap": true,
      "systemAgent": {
        "agentId": "main"
      },
      "compaction": {
        "memoryFlush": {
          "enabled": false
        }
      },
      "userTimezone": "Europe/Istanbul",
      "contextInjection": "never",
      "maxConcurrent": 3,
      "subagents": {
        "maxConcurrent": 3
      }
    },
    "entries": {
      "main": {
        "workspace": "~/.openclaw-jarvis/workspace",
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "jarvis_memory_search",
            "jarvis_memory_get",
            "jarvis_note_read",
            "jarvis_note_write",
            "jarvis_work_note",
            "jarvis_work_read"
          ]
        }
      },
      "research": {
        "workspace": "C:\\Users\\Fatih\\.openclaw-jarvis\\research-empty",
        "contextInjection": "never",
        "skills": [],
        "tools": {
          "allow": [
            "tavily_search",
            "web_fetch"
          ]
        },
        "subagents": {
          "allowAgents": []
        },
        "memory": {
          "search": {
            "enabled": false,
            "rememberAcrossConversations": false,
            "experimental": {
              "sessionMemory": false
            }
          }
        }
      }
    },
    "ownership": "explicit"
  },
  "talk": {
    "realtime": {
      "provider": "google",
      "transport": "provider-websocket",
      "brain": "agent-consult",
      "consultRouting": "provider-direct",
      "providers": {
        "google": {
          "model": "gemini-3.8-live"
        }
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "./plugins/jarvis"
      ]
    },
    "entries": {
      "jarvis": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "allowPromptInjection": true
        }
      },
      "tavily": {
        "enabled": true,
        "config": {
          "webSearch": {
            "baseUrl": "https://api.tavily.com"
          }
        }
      },
      "firecrawl": {
        "enabled": false
      },
      "llama-cpp": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true,
        "subagent": {
          "allowModelOverride": true,
          "allowedModels": [
            "jarvis-dream-google/gemini-3.8-flash"
          ]
        },
        "config": {
          "memoryPolicy": {
            "excludeSessions": {
              "chatTypes": [
                "direct",
                "group",
                "channel"
              ]
            }
          },
          "dreaming": {
            "enabled": true,
            "frequency": "0 */6 * * *",
            "timezone": "Europe/Istanbul",
            "model": "jarvis-dream-google/gemini-3.8-flash",
            "storage": {
              "mode": "separate",
              "separateReports": false
            },
            "phases": {
              "light": {
                "enabled": false
              },
              "rem": {
                "enabled": false
              },
              "deep": {
                "enabled": true,
                "maxPromotedSnippetTokens": 160,
                "maxPriorEntryLossFraction": 0,
                "limit": 6,
                "minScore": 0.1,
                "minRecallCount": 1,
                "minUniqueQueries": 1
              }
            }
          }
        }
      }
    },
    "allow": [
      "jarvis",
      "tavily",
      "opencode",
      "google",
      "memory-core",
      "llama-cpp"
    ],
    "slots": {
      "memory": "memory-core"
    }
  },
  "tools": {
    "allow": [
      "read",
      "write",
      "edit",
      "tavily_search",
      "web_fetch",
      "jarvis_memory_search",
      "jarvis_memory_get",
      "jarvis_note_read",
      "jarvis_note_write",
      "jarvis_work_note",
      "jarvis_work_read"
    ],
    "deny": [
      "exec",
      "process",
      "apply_patch",
      "code_execution",
      "browser",
      "computer",
      "nodes",
      "message",
      "sessions_spawn",
      "sessions_send",
      "subagents",
      "gateway",
      "plugins",
      "openclaw",
      "cron",
      "automations",
      "web_search",
      "tavily_extract",
      "jarvis_web_fetch",
      "memory_search",
      "memory_get"
    ],
    "elevated": {
      "enabled": false
    },
    "exec": {
      "security": "deny",
      "ask": "always"
    },
    "web": {
      "search": {
        "enabled": false,
        "provider": "tavily",
        "cacheTtlMinutes": 0
      },
      "fetch": {
        "enabled": true,
        "readability": true,
        "maxChars": 20000,
        "maxCharsCap": 20000,
        "maxResponseBytes": 262144,
        "timeoutSeconds": 10,
        "cacheTtlMinutes": 0,
        "maxRedirects": 0,
        "useTrustedEnvProxy": false,
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": false,
          "allowRfc2544BenchmarkRange": false,
          "allowIpv6UniqueLocalRange": false
        }
      }
    }
  },
  "memory": {
    "citations": "on",
    "search": {
      "enabled": true,
      "provider": "local",
      "fallback": "none",
      "sources": [
        "memory"
      ],
      "rememberAcrossConversations": false,
      "experimental": {
        "sessionMemory": false
      },
      "extraPaths": [],
      "local": {
        "modelPath": "hf:ggml-org/embeddinggemma-300m-qat-q8_0-GGUF/embeddinggemma-300m-qat-Q8_0.gguf"
      },
      "query": {
        "maxResults": 6,
        "minScore": 0.35
      }
    }
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": false
        }
      }
    }
  },
  "cron": {
    "enabled": true
  },
  "models": {
    "providers": {
      "jarvis-dream-google": {
        "apiKey": {
          "provider": "jarvis-dreaming",
          "source": "env",
          "id": "JARVIS_DREAMING_GEMINI_API_KEY"
        },
        "models": [
          {
            "name": "gemini-3.8-flash (selected Dreaming only)",
            "maxTokens": 65536,
            "reasoning": true,
            "contextWindow": 1048576,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheWrite": 0,
              "cacheRead": 0
            },
            "input": [
              "text"
            ],
            "id": "gemini-3.8-flash"
          },
          {
            "name": "gemini-3.6-flash (selected Dreaming only)",
            "maxTokens": 65536,
            "reasoning": true,
            "contextWindow": 1048576,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheWrite": 0,
              "cacheRead": 0
            },
            "input": [
              "text"
            ],
            "id": "gemini-3.6-flash"
          },
          {
            "name": "gemini-3.5-flash (selected Dreaming only)",
            "maxTokens": 65536,
            "reasoning": true,
            "contextWindow": 1048576,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheWrite": 0,
              "cacheRead": 0
            },
            "input": [
              "text"
            ],
            "id": "gemini-3.5-flash"
          },
          {
            "name": "gemini-3.5-flash-lite (selected Dreaming only)",
            "maxTokens": 65536,
            "reasoning": true,
            "contextWindow": 1048576,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheWrite": 0,
              "cacheRead": 0
            },
            "input": [
              "text"
            ],
            "id": "gemini-3.5-flash-lite"
          },
          {
            "name": "gemini-3.1-flash-lite (selected Dreaming only)",
            "maxTokens": 65536,
            "reasoning": true,
            "contextWindow": 1048576,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheWrite": 0,
              "cacheRead": 0
            },
            "input": [
              "text"
            ],
            "id": "gemini-3.1-flash-lite"
          }
        ],
        "api": "google-generative-ai",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
      }
    }
  },
  "secrets": {
    "providers": {
      "jarvis-dreaming": {
        "allowlist": [
          "JARVIS_DREAMING_GEMINI_API_KEY"
        ],
        "source": "env"
      }
    }
  }
}
