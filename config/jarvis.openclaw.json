{
  "$schema": "https://docs.openclaw.ai/gateway/configuration-reference",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${JARVIS_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true
    },
    "nodes": {
      "pairing": {
        "autoApproveLocal": false,
        "sshVerify": false
      },
      "commands": {
        "deny": [
          "system.run",
          "system.run.prepare",
          "system.which",
          "system.execApprovals.get",
          "system.execApprovals.set",
          "codex.exec-server.stdio.v1",
          "fs.listDir",
          "terminal.upload",
          "browser.proxy.upload.v1",
          "mcp.tools.call.v1",
          "desktop.stream"
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw-jarvis/workspace",
      "model": {
        "primary": "opencode/space-bunny-free",
        "fallbacks": []
      },
      "utilityModel": "",
      "modelSelectionScope": "session",
      "skipBootstrap": true,
      "systemAgent": {
        "agentId": "main"
      },
      "compaction": {
        "memoryFlush": {
          "enabled": false
        }
      },
      "userTimezone": "Europe/Istanbul",
      "contextInjection": "never",
      "maxConcurrent": 3,
      "subagents": {
        "maxConcurrent": 3
      }
    },
    "entries": {
      "main": {
        "workspace": "~/.openclaw-jarvis/workspace",
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "jarvis_memory_search",
            "jarvis_memory_get",
            "jarvis_note_read",
            "jarvis_note_write",
            "jarvis_work_note",
            "jarvis_work_read",
            "jarvis_windows",
            "jarvis_recycle",
            "jarvis_document",
            "jarvis_draft",
            "browser",
            "computer",
            "windows_gui__ControlStatus",
            "windows_gui__Snapshot",
            "windows_gui__Screenshot",
            "windows_gui__Click",
            "windows_gui__Type",
            "windows_gui__Scroll",
            "windows_gui__Move",
            "windows_gui__Shortcut",
            "windows_gui__WaitFor",
            "windows_gui__MultiEdit",
            "windows_gui__MultiSelect"
          ]
        }
      },
      "research": {
        "workspace": "C:\\Users\\Fatih\\.openclaw-jarvis\\research-empty",
        "contextInjection": "never",
        "skills": [],
        "tools": {
          "allow": [
            "tavily_search",
            "web_fetch"
          ]
        },
        "subagents": {
          "allowAgents": []
        },
        "memory": {
          "search": {
            "enabled": false,
            "rememberAcrossConversations": false,
            "experimental": {
              "sessionMemory": false
            }
          }
        }
      }
    },
    "ownership": "explicit"
  },
  "talk": {
    "realtime": {
      "provider": "google",
      "transport": "provider-websocket",
      "brain": "agent-consult",
      "consultRouting": "provider-direct",
      "providers": {
        "google": {
          "model": "gemini-3.8-live"
        }
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "C:\\Users\\Fatih\\Desktop\\Avalon\\plugins\\jarvis"
      ]
    },
    "entries": {
      "jarvis": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "allowPromptInjection": true
        },
        "config": {
          "nativeRoot": "C:\\Users\\Fatih\\Desktop\\Avalon\\native\\windows"
        }
      },
      "tavily": {
        "enabled": true,
        "config": {
          "webSearch": {
            "baseUrl": "https://api.tavily.com"
          }
        }
      },
      "firecrawl": {
        "enabled": false
      },
      "llama-cpp": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true,
        "subagent": {
          "allowModelOverride": true,
          "allowedModels": [
            "jarvis-dream-google/gemini-3.8-flash"
          ]
        },
        "config": {
          "memoryPolicy": {
            "excludeSessions": {
              "chatTypes": [
                "direct",
                "group",
                "channel"
              ]
            }
          },
          "dreaming": {
            "enabled": true,
            "frequency": "0 */6 * * *",
            "timezone": "Europe/Istanbul",
            "model": "jarvis-dream-google/gemini-3.8-flash",
            "storage": {
              "mode": "separate",
              "separateReports": false
            },
            "phases": {
              "light": {
                "enabled": false
              },
              "rem": {
                "enabled": false
              },
              "deep": {
                "enabled": true,
                "limit": 6,
                "minScore": 0.1,
                "minRecallCount": 1,
                "minUniqueQueries": 1,
                "maxPromotedSnippetTokens": 160,
                "maxPriorEntryLossFraction": 0
              }
            }
          }
        }
      },
      "browser": {
        "enabled": true
      }
    },
    "allow": [
      "jarvis",
      "tavily",
      "opencode",
      "google",
      "memory-core",
      "llama-cpp",
      "browser",
      "cua-computer"
    ],
    "slots": {
      "memory": "memory-core"
    }
  },
  "tools": {
    "allow": [
      "read",
      "write",
      "edit",
      "tavily_search",
      "web_fetch",
      "jarvis_memory_search",
      "jarvis_memory_get",
      "jarvis_note_read",
      "jarvis_note_write",
      "jarvis_work_note",
      "jarvis_work_read",
      "jarvis_windows",
      "jarvis_recycle",
      "jarvis_document",
      "jarvis_draft",
      "browser",
      "computer",
      "windows_gui__ControlStatus",
      "windows_gui__Snapshot",
      "windows_gui__Screenshot",
      "windows_gui__Click",
      "windows_gui__Type",
      "windows_gui__Scroll",
      "windows_gui__Move",
      "windows_gui__Shortcut",
      "windows_gui__WaitFor",
      "windows_gui__MultiEdit",
      "windows_gui__MultiSelect"
    ],
    "deny": [
      "exec",
      "process",
      "apply_patch",
      "code_execution",
      "nodes",
      "message",
      "sessions_spawn",
      "sessions_send",
      "subagents",
      "gateway",
      "plugins",
      "openclaw",
      "cron",
      "automations",
      "web_search",
      "tavily_extract",
      "jarvis_web_fetch",
      "memory_search",
      "memory_get"
    ],
    "elevated": {
      "enabled": false
    },
    "exec": {
      "security": "deny",
      "ask": "always"
    },
    "web": {
      "search": {
        "enabled": false,
        "provider": "tavily",
        "cacheTtlMinutes": 0
      },
      "fetch": {
        "enabled": true,
        "readability": true,
        "maxChars": 20000,
        "maxCharsCap": 20000,
        "maxResponseBytes": 262144,
        "timeoutSeconds": 10,
        "cacheTtlMinutes": 0,
        "maxRedirects": 0,
        "useTrustedEnvProxy": false,
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": false,
          "allowRfc2544BenchmarkRange": false,
          "allowIpv6UniqueLocalRange": false
        }
      }
    }
  },
  "memory": {
    "citations": "on",
    "search": {
      "enabled": true,
      "provider": "local",
      "fallback": "none",
      "sources": [
        "memory"
      ],
      "rememberAcrossConversations": false,
      "experimental": {
        "sessionMemory": false
      },
      "extraPaths": [],
      "local": {
        "modelPath": "hf:ggml-org/embeddinggemma-300m-qat-q8_0-GGUF/embeddinggemma-300m-qat-Q8_0.gguf"
      },
      "query": {
        "maxResults": 6,
        "minScore": 0.35
      }
    }
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": false
        }
      }
    }
  },
  "cron": {
    "enabled": true
  },
  "models": {
    "providers": {
      "jarvis-dream-google": {
        "api": "google-generative-ai",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "apiKey": {
          "source": "env",
          "provider": "jarvis-dreaming",
          "id": "JARVIS_DREAMING_GEMINI_API_KEY"
        },
        "models": [
          {
            "id": "gemini-3.8-flash",
            "name": "gemini-3.8-flash (selected Dreaming only)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          },
          {
            "id": "gemini-3.6-flash",
            "name": "gemini-3.6-flash (selected Dreaming only)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          },
          {
            "id": "gemini-3.5-flash",
            "name": "gemini-3.5-flash (selected Dreaming only)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          },
          {
            "id": "gemini-3.5-flash-lite",
            "name": "gemini-3.5-flash-lite (selected Dreaming only)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          },
          {
            "id": "gemini-3.1-flash-lite",
            "name": "gemini-3.1-flash-lite (selected Dreaming only)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          }
        ]
      }
    }
  },
  "secrets": {
    "providers": {
      "jarvis-dreaming": {
        "source": "env",
        "allowlist": [
          "JARVIS_DREAMING_GEMINI_API_KEY"
        ]
      }
    }
  },
  "browser": {
    "enabled": true,
    "evaluateEnabled": false,
    "allowSystemProfileImport": false,
    "defaultProfile": "jarvis-visible",
    "headless": false,
    "noSandbox": false,
    "attachOnly": false,
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": false,
      "allowRfc2544BenchmarkRange": false,
      "allowIpv6UniqueLocalRange": false
    },
    "profiles": {
      "jarvis-visible": {
        "cdpPort": 18810,
        "headless": false
      },
      "jarvis-background": {
        "cdpPort": 18811,
        "headless": true
      }
    }
  },
  "mcp": {
    "sessionIdleTtlMs": 0,
    "servers": {
      "windows_gui": {
        "command": "C:\\Users\\Fatih\\.local\\bin\\uvx.exe",
        "args": [
          "--offline",
          "--from",
          "windows-mcp==0.8.8",
          "windows-mcp",
          "serve",
          "--transport",
          "stdio",
          "--tools",
          "ControlStatus,Snapshot,Screenshot,Click,Type,Scroll,Move,Shortcut,WaitFor,MultiEdit,MultiSelect"
        ],
        "env": {
          "ANONYMIZED_TELEMETRY": "false"
        },
        "toolFilter": {
          "include": [
            "ControlStatus",
            "Snapshot",
            "Screenshot",
            "Click",
            "Type",
            "Scroll",
            "Move",
            "Shortcut",
            "WaitFor",
            "MultiEdit",
            "MultiSelect"
          ]
        },
        "supportsParallelToolCalls": false,
        "connectionTimeoutMs": 15000,
        "requestTimeoutMs": 20000
      }
    }
  }
}
