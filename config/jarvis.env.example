# JARVIS (02) — güvenli yerel ayar şablonu
# Bu dosya repo DIŞINDA tutulur. Gerçek değerleri buraya yazıp
# depoya koyma. Gerçek dosya konumu:
#   %USERPROFILE%\.openclaw-jarvis\.env
# PowerShell'de bir kerelik kurulum:
#   New-Item -ItemType Directory -Force "$env:USERPROFILE\.openclaw-jarvis" | Out-Null
#   Copy-Item "config\jarvis.env.example" "$env:USERPROFILE\.openclaw-jarvis\.env"
#   notepad "$env:USERPROFILE\.openclaw-jarvis\.env"
# Sonra yalnız değerleri doldur, kaydet, kapat. Bu dosyayı
# prompt/log/issue içine yapıştırma.

# Gateway yerel token (zorunlu). PowerShell 7'de yeni token üretip
# kullanıcı ortamında sakla (token ekrana yazılmaz):
#   $token = [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   setx JARVIS_GATEWAY_TOKEN $token
# Mevcut token'ı bu komutlarla değiştirme; yalnız ilk kurulumda kullan.
# setx sonrası terminali/üst uygulamayı yeniden aç; aşağıdaki satırı
# kullanacaksan aynı token'ı yalnız bu yerel .env dosyasına yaz.
# Mevcut yapılandırılmış token'ı GÖSTERME komutu (üretmez):
#   .\node_modules\.bin\openclaw.cmd --profile jarvis gateway auth-token --show
# Yalnız kendi etkileşimli terminalinde kullan; çıktısını prompt/log'a taşıma.
JARVIS_GATEWAY_TOKEN=

# Ana görev modeli (zorunlu, 02 sonrası kullanım için).
# OpenCode konsolundan üret: https://opencode.ai/auth
# Yalnız Space Bunny Free başlangıç rotası; ücretli Go yok.
OPENCODE_API_KEY=

# Google Live / Talk (11. aşamaya kadar ZORUNLU DEĞİL).
# Google AI Studio'dan üret: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily ücretsiz Researcher arama hesabı (03). Anahtarı repo içine yazma.
# Tercihen kendi terminalinde .\scripts\set-tavily-key.ps1 ile gizli giriş yap.
# .env yolu kullanılacaksa yalnız yukarıdaki repo DIŞI dosyada değer tanımla.
# Advanced arama 2 kredi/istek; 1.000 kredi/ay toplamından kullanır.
# Ücretli plan/otomatik ödeme/fallback açılmaz.
TAVILY_API_KEY=
