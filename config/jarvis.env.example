# JARVIS (02) — güvenli yerel ayar şablonu
# Bu dosya repo DIŞINDA tutulur. Gerçek değerleri buraya yazıp
# depoya koyma. Gerçek dosya konumu:
#   %USERPROFILE%\.openclaw-jarvis\.env
# PowerShell'de bir kerelik kurulum:
#   New-Item -ItemType Directory -Force "$env:USERPROFILE\.openclaw-jarvis" | Out-Null
#   Copy-Item "config\jarvis.env.example" "$env:USERPROFILE\.openclaw-jarvis\.env"
#   notepad "$env:USERPROFILE\.openclaw-jarvis\.env"
# Sonra yalnız değerleri doldur, kaydet, kapat. Bu dosyayı
# prompt/log/issue içine yapıştırma.

# Gateway yerel token (zorunlu). Üret:
#   npm exec --no-install openclaw -- --profile jarvis gateway token
# Çıkan değeri tırnaksız yaz.
JARVIS_GATEWAY_TOKEN=

# Ana görev modeli (zorunlu, 02 sonrası kullanım için).
# OpenCode konsolundan üret: https://opencode.ai/auth
# Yalnız Space Bunny Free başlangıç rotası; ücretli Go yok.
OPENCODE_API_KEY=

# Google Live / Talk (11. aşamaya kadar ZORUNLU DEĞİL).
# Google AI Studio'dan üret: https://aistudio.google.com/apikey
GEMINI_API_KEY=
