  {
    "source": "https://evren-llmapi.ssyz.org.tr/openapi.json",
    "status": 200,
    "schema": {
      "properties": {
        "model": {
          "type": "string",
          "title": "Model",
          "description": "ID of the model to use. See `GET /v1/models`."
        },
        "messages": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array",
          "title": "Messages",
          "description": "Conversation so far, as a list of `{role, content}` objects."
        },
        "stream": {
          "type": "boolean",
          "title": "Stream",
          "description": "If true, partial message deltas are sent as server-sent events.",
          "default": false
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Tokens",
          "description": "Maximum number of tokens to generate."
        },
        "evren_tools": {
          "type": "boolean",
          "title": "Evren Tools",
          "description": "EVREN extension (non-standard): opt-in to server-executed live-data tools when `tools` is not supplied.",
          "default": false
        }
      },
      "additionalProperties": true,
      "type": "object",
      "required": [
        "model",
        "messages"
      ],
      "title": "ChatCompletionRequest",
      "description": "OpenAI sözleşmesinin GEREKLİ alanları - diğer tüm parametreler\n(reasoning_effort, tools, seed, top_k, stop...) `extra='allow'` ile\nolduğu gibi vLLM'e geçer; yetenek doğrulaması chat_service'te ayrıca yapılır."
    }
  }
