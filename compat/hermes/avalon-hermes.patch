@@ -0,0 +1,62 @@
+"""A repair request has a real deadline and aborts its own client, never the shared client."""
+from contextvars import ContextVar
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+import threading
+
+import pytest
+
+from agent.final_reply_request import bounded_reply_completion
+
+
+def make_agent(call):
+    client = Mock()
+    client.with_options.return_value = client
+    client.chat.completions.create.side_effect = call
+    agent = NS(provider="custom", model="qwen3.8-flash-next", base_url="https://evren-llmapi.ssyz.org.tr/v1",
+               api_mode="chat_completions", _interrupt_requested=False, _active_request_abort=None,
+               _pending_redirect_lock=threading.Lock(), _model_request_active=threading.Event(),
+               _create_request_openai_client=Mock(return_value=client),
+               _close_request_openai_client=Mock(), _abort_request_openai_client=Mock())
+    return agent, client
+
+
+def test_one_request_copies_profile_scope_and_clears_busy_and_abort():
+    profile = ContextVar("repair_test_profile", default="launch")
+    token = profile.set("owning-profile")
+    seen = []
+    agent, client = make_agent(lambda **kwargs: seen.append(profile.get()) or "answer")
+    previous = lambda reason: None
+    agent._active_request_abort = previous
+    try:
+        assert bounded_reply_completion(agent, {"model": agent.model}) == "answer"
+    finally:
+        profile.reset(token)
+    assert seen == ["owning-profile"]
+    client.with_options.assert_called_once_with(max_retries=0, timeout=10.0)
+    client.chat.completions.create.assert_called_once()
+    assert not agent._model_request_active.is_set() and agent._active_request_abort is previous
+    agent._abort_request_openai_client.assert_not_called()
+    agent._close_request_openai_client.assert_called_once()
+
+
+def test_stop_discards_even_a_complete_late_response():
+    agent, _ = make_agent(lambda **kwargs: setattr(agent, "_interrupt_requested", True) or "late answer")
+    with pytest.raises(InterruptedError):
+        bounded_reply_completion(agent, {})
+    assert agent._active_request_abort is None and not agent._model_request_active.is_set()
+
+
+def test_timeout_aborts_request_without_waiting_for_late_worker(monkeypatch):
+    entered, release = threading.Event(), threading.Event()
+    agent, client = make_agent(lambda **kwargs: entered.set() or release.wait(5) or "late answer")
+    agent._abort_request_openai_client.side_effect = lambda *args, **kwargs: release.set()
+    import agent.final_reply_request as module
+    monkeypatch.setattr(module, "monotonic", lambda: 11.0 if entered.is_set() else 0.0)
+    try:
+        with pytest.raises(TimeoutError):
+            bounded_reply_completion(agent, {}, timeout=10)
+    finally:
+        release.set()
+    assert agent._active_request_abort is None and not agent._model_request_active.is_set()
+    client.chat.completions.create.assert_called_once()
