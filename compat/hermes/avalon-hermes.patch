+"""Only complete prose is regenerated; api_request copies and permission boundaries stay isolated."""
+from copy import deepcopy
+import json
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+
+from tui_gateway.iris_contract import iris_final_response_policy, validate_iris_contract
+from tui_gateway.iris_reply_repair import PlainTextReplyRepair, decode_reply, repair_kwargs
+
+
+def completion(text, reason="stop", tool_calls=None):
+    return NS(choices=[NS(message=NS(content=text, tool_calls=tool_calls), finish_reason=reason)],
+              usage=NS(prompt_tokens=100, completion_tokens=20))
+
+
+@pytest.fixture
+def route():
+    return NS(provider="custom", model="qwen3.8-flash-next", api_mode="chat_completions",
+              base_url="https://evren-llmapi.ssyz.org.tr/v1", _interrupt_requested=False)
+
+
+@pytest.fixture
+def api_request():
+    return {"model": "qwen3.8-flash-next", "messages": [
+        {"role": "system", "content": "Avalon; warm and natural; Turkish."},
+        {"role": "user", "content": "Adın ne?"}], "tools": [{"type": "function"}],
+        "tool_choice": "auto", "max_tokens": 900, "extra_body": {"thinking": False}}
+
+
+@pytest.fixture
+def repair_call(monkeypatch):
+    call = Mock()
+    monkeypatch.setattr("tui_gateway.iris_reply_repair.bounded_reply_completion", call)
+    monkeypatch.setattr(PlainTextReplyRepair, "_usage", staticmethod(lambda *args: None))
+    return call
+
+
+def invoke(policy, route, api_request, text, reason="stop"):
+    return policy(route, text, api_kwargs=api_request, finish_reason=reason,
+                  messages=api_request["messages"], api_call_count=1)
+
+
+def test_version_two_is_explicit_and_version_one_keeps_its_shape():
+    v1 = {"version": 1, "instructions": "Speak as Avalon."}
+    v2 = {**v1, "version": 2, "final_reply_repair": "plain_text_once"}
+    assert validate_iris_contract(v1, "voice-live") == v1
+    assert validate_iris_contract(v2, "voice-live") == v2
+    for invalid in ({**v1, "final_reply_repair": "plain_text_once"},
+                    {**v2, "final_reply_repair": "always"}, {**v2, "version": True}):
+        with pytest.raises(ValueError):
+            validate_iris_contract(invalid, "voice-live")
+    with pytest.raises(ValueError):
+        validate_iris_contract(v2, "hud")
+
+
+def test_policy_is_per_visible_turn_and_busy_queue_preserves_v2():
+    from tui_gateway import server
+
+    v1 = {"version": 1, "instructions": "Speak as Avalon."}
+    v2 = {**v1, "version": 2, "final_reply_repair": "plain_text_once"}
+    assert iris_final_response_policy(None) is None
+    assert iris_final_response_policy(v1) is None
+    assert iris_final_response_policy(v2, "hidden") is None
+    first, second = iris_final_response_policy(v2), iris_final_response_policy(v2)
+    assert isinstance(first, PlainTextReplyRepair) and first is not second
+    first.attempted = True
+    assert not second.attempted
+    session = {}
+    queued = server._enqueue_prompt(session, "Adın ne?", None, iris_contract=v2)
+    assert queued["iris_contract"] == v2
+    unrelated = server._enqueue_prompt(session, "Hidden context", None, iris_contract=v1)
+    assert unrelated is not queued and unrelated["iris_contract"] == v1
+
+
+@pytest.mark.parametrize("text", ["Ben Avalon, efendim.", "Ben Avalon. Size nasıl yardımcı olabilirim?",
+                                   'Ben Avalon; "hazırım", efendim.', "Ben Avalon.\nBuradayım.",
+                                   "Ben Avalon, kişisel asistanınızım.", "Ben Avalon — emrinizdeyim."])
+def test_plain_identity_replies_are_preserved_exactly_once(route, api_request, repair_call, text):
+    before = deepcopy(api_request)
+    envelope = json.dumps({"reply": text, "proposal": None}, ensure_ascii=False)
+    repair_call.return_value = completion(envelope)
+    policy = PlainTextReplyRepair()
+    assert invoke(policy, route, api_request, text) == (envelope, 1)
+    assert invoke(policy, route, api_request, text) == (text, 0)
+    assert repair_call.call_count == 1
+    assert api_request == before
+
+
+@pytest.mark.parametrize("text", [
+    '{"reply":"Hazırım","proposal":null}', '```json\n{"reply":"ok","proposal":null}\n```',
+    '{"reply":', '{"reply":"Onaylıyor musun?","proposal":{"goal":""}}',
+    '{"reply":"","proposal":{"goal":"x","constraints":"eksik"}}',
+    'Not: "proposal": {bozuk}', "[]", '"JSON scalar"', "null", "", "   ",
+])
+def test_structured_invalid_empty_and_valid_replies_never_trigger_repair(route, api_request, repair_call, text):
+    assert invoke(PlainTextReplyRepair(), route, api_request, text) == (text, 0)
+    repair_call.assert_not_called()
+
+
+@pytest.mark.parametrize("change,reason", [({"model": "another-model"}, "stop"),
+    ({"base_url": "https://other.example/v1"}, "stop"), ({"provider": "openrouter"}, "stop"),
+    ({"api_mode": "codex_responses"}, "stop"), ({"_interrupt_requested": True}, "stop"),
+    ({}, "length"), ({}, "error"), ({}, "content_filter")])
+def test_unsupported_routes_and_incomplete_or_cancelled_turns_are_untouched(route, api_request, repair_call, change, reason):
+    for key, value in change.items():
+        setattr(route, key, value)
+    text = "Ben Avalon, efendim."
+    assert invoke(PlainTextReplyRepair(), route, api_request, text, reason) == (text, 0)
+    repair_call.assert_not_called()
+
+
+def test_repair_omits_tools_including_nested_overrides_and_retains_reasoning(api_request):
+    api_request.update(stream=True, stream_options={"include_usage": True}, parallel_tool_calls=True)
+    api_request["extra_body"].update(tools=[], tool_choice="required", max_tokens=400, response_format={"type": "text"})
+    original = deepcopy(api_request)
+    result = repair_kwargs(api_request, "Ben Avalon, efendim.")
+    for key in ("tools", "tool_choice", "parallel_tool_calls", "stream", "stream_options"):
+        assert key not in result and key not in result["extra_body"]
+    assert result["extra_body"] == {"thinking": False}
+    assert result["max_tokens"] == 400 and result["timeout"] == 10
+    assert result["response_format"]["type"] == "json_schema"
+    assert result["messages"][0]["content"].startswith(original["messages"][0]["content"])
+    assert all(m["role"] != "system" for m in result["messages"][1:])
+    assert result["messages"][-2]["content"] == "Ben Avalon, efendim."
+    assert api_request == original
+
+
+def test_a_request_model_override_cannot_enable_repair_on_an_unverified_model(route, api_request, repair_call):
+    api_request["model"] = "unverified-model"
+    raw = "Ben Avalon."
+    assert invoke(PlainTextReplyRepair(), route, api_request, raw) == (raw, 0)
+    repair_call.assert_not_called()
+
+
+def test_real_tool_results_are_retained_in_request_copy(route, api_request, repair_call):
+    tool_rows = [{"role": "assistant", "content": None, "tool_calls": [{"id": "c1", "type": "function",
+        "function": {"name": "web_search", "arguments": '{"query":"Ankara"}'}}]},
+        {"role": "tool", "tool_call_id": "c1", "content": "Synthetic search result"}]
+    api_request["messages"].extend(tool_rows)
+    repair_call.side_effect = lambda agent, kwargs: completion(json.dumps({"reply": "Kaynağı buldum.", "proposal": None}))
+    invoke(PlainTextReplyRepair(), route, api_request, "Kaynağı buldum.")
+    copied = repair_call.call_args.args[1]["messages"]
+    assert copied[2:4] == tool_rows and api_request["messages"][2:] == tool_rows
+
+
+@pytest.mark.parametrize("result", [
+    completion('{"reply":"Değiştirilmiş cümle","proposal":null}'),
+    completion('{"reply":"","proposal":null}'), completion('{"reply":'),
+    completion('{"reply":"Ben Avalon.","proposal":null,"unexpected":NaN}'),
+    completion('{"reply":"Ben Avalon.","proposal":null}', "length"),
+    completion('{"reply":"Ben Avalon.","proposal":null}', tool_calls=[{"id": "bad"}]),
+    completion('{"reply":"Onaylıyor musun?","proposal":{"goal":"Task"}}'),
+    TimeoutError("private response text"), RuntimeError("private API credential"),
+])
+def test_failed_recovery_never_changes_reply_or_retries(route, api_request, repair_call, result, caplog):
+    if isinstance(result, Exception):
+        repair_call.side_effect = result
+    else:
+        repair_call.return_value = result
+    policy, raw = PlainTextReplyRepair(), "Ben Avalon."
+    with caplog.at_level("INFO", logger="tui_gateway.iris_reply_repair"):
+        assert invoke(policy, route, api_request, raw) == (raw, 1)
+    assert invoke(policy, route, api_request, raw) == (raw, 0)
+    assert repair_call.call_count == 1
+    assert raw not in caplog.text and "private" not in caplog.text
+
+
+def test_task_recovery_keeps_explicit_targets_and_constraints(route, api_request, repair_call):
+    api_request["messages"][-1]["content"] = "Masaüstünde rapor.txt oluştur; diğer dosyalara dokunma."
+    proposal = {"goal": "Masaüstünde rapor.txt oluştur", "constraints": ["Diğer dosyalara dokunma"],
+                "readback": "Diğer dosyalara dokunmadan masaüstünde rapor.txt oluşturayım mı?"}
+    envelope = json.dumps({"reply": "", "proposal": proposal}, ensure_ascii=False)
+    repair_call.return_value = completion(envelope)
+    output, calls = invoke(PlainTextReplyRepair(), route, api_request, "Raporu hazırlayayım mı?")
+    assert calls == 1 and decode_reply(output)["proposal"] == proposal
+    assert repair_call.call_args.args[1]["messages"][1] == api_request["messages"][1]
