+"""Iris instructions are opt-in, isolated and retained by the existing busy queue."""
+from types import SimpleNamespace
+
+import pytest
+
+from tui_gateway.iris_contract import iris_contract_scope, iris_voice_note, validate_iris_contract
+
+CONTRACT = {"version": 1, "instructions": "Speak naturally as Iris."}
+
+
+def test_contract_validation_and_scope_restore_on_failure():
+    agent = SimpleNamespace(valid_tool_names={"web_search", "clarify"}, ephemeral_system_prompt="User instructions")
+    assert validate_iris_contract(CONTRACT, "voice-live") == CONTRACT
+    with pytest.raises(RuntimeError), iris_contract_scope(agent, CONTRACT):
+        assert agent.ephemeral_system_prompt.startswith("User instructions\n\n")
+        assert CONTRACT["instructions"] in agent.ephemeral_system_prompt
+        raise RuntimeError("provider failed")
+    assert agent.ephemeral_system_prompt == "User instructions"
+    with iris_contract_scope(agent, None):
+        assert agent.ephemeral_system_prompt == "User instructions"
+    for value, surface in [({**CONTRACT, "version": 2}, "voice-live"), (CONTRACT, "hud"), ({**CONTRACT, "version": True}, "voice-live")]:
+        with pytest.raises(ValueError):
+            validate_iris_contract(value, surface)
+    agent.valid_tool_names.add("terminal")
+    with pytest.raises(ValueError), iris_contract_scope(agent, CONTRACT):
+        pytest.fail("unrestricted tools must not run the conversation")
+
+
+def test_source_note_preserves_budget_without_generic_execution_or_paraphrasing():
+    note = iris_voice_note("source-data " + "x" * 7000)
+    assert "source-data " in note and "x" * 6000 not in note
+    assert "mis-hearings" in note and "latest intent" in note
+    assert "voiced verbatim" in note and "not permission" in note
+    assert "paraphrases" not in note and "Do the work" not in note
+
+
+def test_busy_queue_keeps_contract_and_never_merges_an_unrelated_turn():
+    from tui_gateway import server
+    session = {}
+    first = server._enqueue_prompt(session, "Edge AI", None, iris_contract=CONTRACT)
+    second = server._enqueue_prompt(session, "Turkiye", None, iris_contract=CONTRACT)
+    assert second is first and first["text"] == "Edge AI\n\nTurkiye"
+    assert first["iris_contract"] == CONTRACT
+    unrelated = server._enqueue_prompt(session, "ordinary turn", None)
+    assert unrelated is not first and "iris_contract" not in unrelated
+    assert session["queued_prompts"] == [unrelated]
