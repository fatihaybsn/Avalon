@@ -0,0 +1,24 @@
+"""Prepare the final assistant text before its first durable write."""
+
+
+def prepare_final_reply(
+    agent, text, final_msg, *, promoted, policy, api_kwargs, finish_reason,
+    messages, api_call_count, interrupted, logger,
+):
+    from agent.turn_finalizer import apply_llm_output_transform
+
+    if not getattr(agent, "_interrupt_requested", False):
+        text, transformed, _ = apply_llm_output_transform(
+            agent, text, turn_id=getattr(agent, "_current_turn_id", "") or "", logger=logger,
+        )
+        if transformed:
+            final_msg["api_content" if promoted else "content"] = text
+    if policy is not None:
+        if not getattr(agent, "_interrupt_requested", False):
+            text, extra_calls = policy(agent, text, api_kwargs=api_kwargs, finish_reason=finish_reason,
+                                       messages=messages, api_call_count=api_call_count)
+            api_call_count += extra_calls
+        if getattr(agent, "_interrupt_requested", False):
+            return None, api_call_count, True
+        final_msg["api_content" if promoted else "content"] = text
+    return text, api_call_count, interrupted
