diff --git a/agent/final_reply_request.py b/agent/final_reply_request.py
new file mode 100644
index 0000000..96c5793
--- /dev/null
+++ b/agent/final_reply_request.py
@@ -0,0 +1,83 @@
+"""One bounded, non-streaming completion inside the owning conversation turn.
+
+Uses the existing request-client registry: cancellation aborts only this request's
+sockets and the worker remains responsible for closing its client.
+"""
+from __future__ import annotations
+
+from contextlib import nullcontext
+import threading
+from time import monotonic
+
+
+def bounded_reply_completion(agent, api_kwargs, *, timeout=10.0):
+    """No retry, fallback, streaming, transcript writes or tool dispatch."""
+    from agent.chat_completion_helpers import _RequestClientRegistry
+    from agent.memory_provider import spawn_context_thread
+
+    registry = _RequestClientRegistry(agent)
+    done, cancelled = threading.Event(), threading.Event()
+    outcome = {}
+    deadline = monotonic() + timeout
+    route = (agent.provider, agent.model, agent.base_url, agent.api_mode)
+
+    def stopped():
+        return (cancelled.is_set() or getattr(agent, "_interrupt_requested", False)
+                or route != (agent.provider, agent.model, agent.base_url, agent.api_mode))
+
+    def abort(reason="final_reply_cancelled"):
+        cancelled.set()
+        registry.close_once(reason)
+
+    def call():
+        try:
+            if stopped():
+                return
+            client = registry.set_client(agent._create_request_openai_client(
+                reason="final_reply_repair", api_kwargs=api_kwargs))
+            if stopped():
+                return
+            # The request-client factory disables SDK retries. Explicitly retain
+            # that bound even when an alternate client factory is installed.
+            request_client = client.with_options(max_retries=0, timeout=timeout)
+            outcome["response"] = request_client.chat.completions.create(**api_kwargs)
+        except Exception as exc:  # health: allow BLE001 -- Transfer the original worker exception to the caller, which re-raises it.
+            outcome["error"] = exc
+        finally:
+            registry.close_once("request_complete" if not stopped() and "response" in outcome
+                                else "final_reply_cleanup")
+            done.set()
+
+    previous_abort = getattr(agent, "_active_request_abort", None)
+    active = getattr(agent, "_model_request_active", None)
+    lock = getattr(agent, "_pending_redirect_lock", None)
+    bracket = nullcontext() if lock is None else lock
+    with bracket:
+        if stopped():
+            raise InterruptedError("Final reply cancelled before request")
+        agent._active_request_abort = abort
+        if active is not None:
+            active.set()
+    try:
+        spawn_context_thread(call, name="final-reply-repair").start()
+        while True:
+            if stopped():
+                abort()
+                raise InterruptedError("Final reply cancelled")
+            remaining = deadline - monotonic()
+            if remaining <= 0:
+                abort("final_reply_timeout")
+                raise TimeoutError("Final reply deadline exceeded")
+            if done.wait(min(0.05, remaining)):
+                break
+        if stopped():
+            raise InterruptedError("Final reply cancelled after response")
+        if "error" in outcome:
+            raise outcome["error"]
+        return outcome["response"]
+    finally:
+        with bracket:
+            if getattr(agent, "_active_request_abort", None) is abort:
+                agent._active_request_abort = previous_abort
+            if active is not None:
+                active.clear()
