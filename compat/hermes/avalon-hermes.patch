diff --git a/tests/agent/test_final_reply_policy_persistence.py b/tests/agent/test_final_reply_policy_persistence.py
new file mode 100644
index 0000000..037a5dc
--- /dev/null
+++ b/tests/agent/test_final_reply_policy_persistence.py
@@ -0,0 +1,155 @@
+"""Repair runs after output hooks and before the first durable assistant write."""
+import json
+from types import SimpleNamespace as NS
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from hermes_state import SessionDB
+from run_agent import AIAgent
+from tui_gateway.iris_reply_repair import PlainTextReplyRepair
+
+
+def response(text):
+    return NS(choices=[NS(message=NS(content=text, tool_calls=None, reasoning=None), finish_reason="stop")],
+              usage=NS(prompt_tokens=100, completion_tokens=15, total_tokens=115), model="qwen3.8-flash-next")
+
+
+@pytest.fixture
+def db_agent(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    db = SessionDB(db_path=home / "state.db")
+    with (patch("model_tools.get_tool_definitions", return_value=[]),
+          patch("model_tools.check_toolset_requirements", return_value={}),
+          patch("agent.process_bootstrap.OpenAI")):
+        agent = AIAgent(api_key="test-key-1234567890", provider="custom", api_mode="chat_completions",
+                        base_url="https://evren-llmapi.ssyz.org.tr/v1", model="qwen3.8-flash-next",
+                        quiet_mode=True, skip_context_files=True, skip_memory=True,
+                        platform="iris", session_id="repair-test", session_db=db)
+    agent.client = MagicMock()
+    agent.client.with_options.return_value = agent.client
+    agent._disable_streaming = True
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", lambda *args, **kwargs: [])
+    yield agent, db
+    agent.close()
+    db.close()
+
+
+def test_repaired_reply_is_the_only_assistant_row_and_internal_instruction_is_not_replayed(db_agent):
+    agent, db = db_agent
+    plain = "Ben Avalon, efendim."
+    envelope = json.dumps({"reply": plain, "proposal": None}, ensure_ascii=False)
+    calls = []
+
+    def create(**kwargs):
+        calls.append(kwargs)
+        return response(envelope if kwargs.get("response_format") else plain)
+
+    agent.client.chat.completions.create.side_effect = create
+    result = agent.run_conversation("Adın ne?", final_response_policy=PlainTextReplyRepair())
+    assert result["completed"] is True and result["final_response"] == envelope
+    assert len(calls) == 2 and "response_format" not in calls[0]
+    assert "tools" not in calls[1] and "tool_choice" not in calls[1]
+    rows = db.get_messages("repair-test")
+    assert [(row["role"], row["content"]) for row in rows if row["role"] != "system"] == [
+        ("user", "Adın ne?"), ("assistant", envelope)]
+    stored = db.get_messages_as_conversation("repair-test")
+    assert "INTERNAL_FORMAT_RETRY_ONLY" not in json.dumps(stored)
+    assert result["api_calls"] == 2 and agent.session_api_calls == 2
+    # Reopening history cannot reintroduce raw prose or internal correction turns.
+    agent.client.chat.completions.create.side_effect = lambda **kwargs: response('{"reply":"Evet.","proposal":null}')
+    again = agent.run_conversation("Hazır mısın?", conversation_history=stored,
+                                   final_response_policy=PlainTextReplyRepair())
+    assert again["completed"] is True
+    replay = agent.client.chat.completions.create.call_args.kwargs["messages"]
+    assert not any("INTERNAL_FORMAT_RETRY_ONLY" in str(m.get("content", "")) for m in replay)
+
+
+def test_valid_reply_has_no_extra_request_and_output_hook_precedes_repair(db_agent, monkeypatch):
+    agent, _ = db_agent
+    raw = '{"reply":"Geçerli yanıt.","proposal":null}'
+    agent.client.chat.completions.create.side_effect = lambda **kwargs: response(raw)
+    result = agent.run_conversation("Selam", final_response_policy=PlainTextReplyRepair())
+    assert result["final_response"] == raw and agent.client.chat.completions.create.call_count == 1
+    observed = []
+
+    def policy(owner, text, **kwargs):
+        observed.append(text)
+        return text, 0
+
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", lambda name, **kwargs:
+                        ["Hook result"] if name == "transform_llm_output" else [])
+    agent.run_conversation("İkinci soru", final_response_policy=policy)
+    assert observed == ["Hook result"]
+
+
+def test_stop_during_repair_never_completes_or_persists_repaired_answer(db_agent):
+    agent, db = db_agent
+    candidate = '{"reply":"Geç gelen yanıt.","proposal":null}'
+    calls = []
+
+    def create(**kwargs):
+        calls.append(kwargs)
+        if kwargs.get("response_format"):
+            agent._interrupt_requested = True
+            return response(candidate)
+        return response("Geç gelen yanıt.")
+
+    agent.client.chat.completions.create.side_effect = create
+    result = agent.run_conversation("Selam", final_response_policy=PlainTextReplyRepair())
+    assert len(calls) == 2 and result["interrupted"] is True and result["completed"] is False
+    assert candidate not in [row["content"] for row in db.get_messages("repair-test")]
+
+
+@pytest.mark.parametrize("tool_name,arguments", [
+    ("web_search", {"query": "Synthetic test query"}),
+    ("web_extract", {"urls": ["https://example.com"]}),
+    ("clarify", {"questions": [{"question": "Hangi biçim?", "choices": ["PDF", "Metin"]}]}),
+])
+def test_normal_tool_loop_runs_before_no_tool_final_repair(db_agent, tool_name, arguments):
+    from agent.message_metadata import append_message
+
+    agent, db = db_agent
+    agent.valid_tool_names = {tool_name}
+    agent.tools = [{"type": "function", "function": {"name": tool_name, "description": "Test tool",
+                   "parameters": {"type": "object", "properties": {}}}}]
+    calls, executed = [], []
+    plain = "Sonucu aldım, efendim."
+    envelope = json.dumps({"reply": plain, "proposal": None}, ensure_ascii=False)
+
+    def execute(message, messages, *args):
+        executed.append(message.tool_calls[0].function.name)
+        append_message(messages, {"role": "tool", "name": tool_name, "tool_call_id": "tool-one",
+                                  "content": "Synthetic tool result; no external action occurred."})
+
+    def create(**kwargs):
+        calls.append(kwargs)
+        if len(calls) == 1:
+            result = response("")
+            result.choices[0].finish_reason = "tool_calls"
+            result.choices[0].message.tool_calls = [NS(id="tool-one", type="function", function=NS(
+                name=tool_name, arguments=json.dumps(arguments)))]
+            return result
+        return response(envelope if kwargs.get("response_format") else plain)
+
+    agent._execute_tool_calls = execute
+    agent.client.chat.completions.create.side_effect = create
+    result = agent.run_conversation("Araçla kontrol et", final_response_policy=PlainTextReplyRepair())
+    assert result["completed"] is True and result["final_response"] == envelope
+    assert executed == [tool_name] and len(calls) == 3
+    assert all("response_format" not in call and call.get("tools") for call in calls[:2])
+    assert "tools" not in calls[2] and "tool_choice" not in calls[2]
+    assert any(m.get("role") == "tool" for m in calls[2]["messages"])
+    rows = db.get_messages("repair-test")
+    assert sum(row["role"] == "user" for row in rows) == 1
+    assert rows[-1]["content"] == envelope
+
+
+def test_version_one_without_policy_keeps_plain_output_and_one_call(db_agent):
+    agent, _ = db_agent
+    agent.client.chat.completions.create.side_effect = lambda **kwargs: response("Ben Avalon.")
+    result = agent.run_conversation("Adın ne?")
+    assert result["final_response"] == "Ben Avalon."
+    assert agent.client.chat.completions.create.call_count == 1
