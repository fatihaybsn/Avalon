+  const current=()=>{request.signal?.throwIfAborted();access.assertCurrent();if(client.invalidated||request.hasCurrentClientAuthority?.()===false)throw new Error('Automation caller retired; do not replay');};
+  try{
+    current();const target=access.target;
+    const job=input.job;
+    if(job){
+      if(Object.keys(job).some(k=>!['name','description','enabled','schedule','payload','delivery','sessionKey','agentId','sessionTarget'].includes(k)))throw new Error('Automation definition outside session-only contract');
+      if(job.sessionKey!==undefined&&job.sessionKey!==target.sessionKey||job.agentId!==undefined&&job.agentId!==target.agentId||job.sessionTarget!==undefined&&job.sessionTarget!=='current')throw new Error('Different automation target');
