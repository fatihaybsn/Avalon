+import { randomUUID } from "node:crypto";
+import { getPluginRuntimeGatewayRequestScope } from "../plugins/runtime/gateway-request-scope.js";
+import { prepareGatewaySessionAccessAuthority } from "../gateway/session-access-authority.js";
+import { cronHandlers } from "../gateway/server-methods/cron.js";
+import { withAuthenticatedCronCallerScope } from "../gateway/server-methods/cron-caller-scope.js";
+import type { GatewayRequestHandlerOptions } from "../gateway/server-methods/types.js";
+import type { GatewayMethodDispatchResponse } from "./gateway-method-runtime.js";
+import { getAgentRunContext } from "../infra/agent-run-registry.js";
+import { assertAgentRunLifecycleGenerationCurrent } from "../infra/agent-events.js";
+
+/** Reads the admitted occurrence, never a job id/description supplied by a model.
+ * The job is a native snapshot: edits cannot relabel an in-flight occurrence.
+ * Native scheduledToolPolicy and the finalized tool cap still own authorization.
+ */
+export function readSessionAutomationExecution(runId:string) {
+  const context=getAgentRunContext(runId);
+  if(!context?.sessionKey||!context.sessionId||!context.agentId)return undefined;
+  const sessionKey=context.sessionKey,sessionId=context.sessionId,agentId=context.agentId;
+  const lifecycleGeneration=context.lifecycleGeneration;
+  const occurrences=context.cronRunsByJobId;
+  if(!lifecycleGeneration||occurrences?.size!==1)return undefined;
+  const first=[...occurrences][0];
+  if(!first)return undefined;
+  const [jobId,entry]=first;
+  const execution=entry.execution;if(!execution)return undefined;
+  const assertCurrent=()=>{
+    execution.signal.throwIfAborted();
+    if(getAgentRunContext(runId)!==context||context.cronRunsByJobId?.get(jobId)?.execution!==execution)throw new Error('Scheduled execution owner ended');
+    assertAgentRunLifecycleGenerationCurrent(lifecycleGeneration);
+  };
+  assertCurrent();
+  return {jobId,runId,sessionKey,sessionId,agentId,job:structuredClone(execution.job),signal:execution.signal,assertCurrent};
+}
+
+/** Native cron entry for an authenticated plugin's human-owned session.
+ * No synthetic operator/admin, model turn, new store or execution grant.
+ * Unattended tool effects still require the ordinary native creator route.
+ */
