+   else if(r.family==='question')await this.rpc.request('question.resolve',decision==='deny'?{id:r.id,cancel:true}:{id:r.id,answers:{answers:Object.fromEntries(Object.entries(a.answers).map(([k,v])=>[k,Array.isArray(v)?v.map(String):[String(v)]]))}},true);
+   else if(r.family==='opencode'){
+    if(r.kind==='form'&&decision==='deny'){
+     await this.rpc.request('jarvis.worker.answer',{sessionKey:r.sessionKey,agentId:'main',runId:r.runId,expectedRevision:r.revision,requestId:r.id,requestHash:r.requestHash,kind:'cancel-form'},true);
+    }else await this.rpc.request('jarvis.worker.answer',{sessionKey:r.sessionKey,agentId:'main',runId:r.runId,expectedRevision:r.revision,requestId:r.id,requestHash:r.requestHash,kind:r.kind,...r.kind==='permission'?{decision:decision==='deny'?'reject':'once'}:{answer:a.answers}},true);
+   }else throw new Error('Unknown native decision family');
+   this.notice('Karar native isteğe iletildi; yürütme sonucu ayrıca kaydedilecek.');
+  }catch(e){this.clear();this.notice(e instanceof Error?e.message:'Karar sonucu belirsiz; tekrar gönderilmedi.');}finally{this.deciding=false;}
+ }
+}
+function requestFieldsSafe(r:Request){try{return requestFields(r);}catch{return undefined;}}
diff --git a/ui/src/lib/jarvis/browser-talk-owner.ts b/ui/src/lib/jarvis/browser-talk-owner.ts
new file mode 100644
--- /dev/null
+++ b/ui/src/lib/jarvis/browser-talk-owner.ts
@@ -0,0 +1,66 @@
+import {VoiceDecisions} from './voice-decisions.ts';
+import {boundedContext} from './host-context.ts';
+
+type Event={type:string;final?:boolean;payload?:any};
+type Callbacks={onStatus?:(phase:any,detail?:string)=>void;onInputLevel?:(level:number)=>void;onTalkEvent?:(event:Event)=>void};
+type Session={getVoiceSessionId:()=>string|undefined;presentQuestion:(text:string)=>void;isOutputPlaying:()=>boolean;updateContext:(text:string)=>void;stop:()=>Promise<void>};
+type Client={connected:boolean;request:(method:string,params:object)=>Promise<any>;addEventListener?:(listener:(e:{event:string;payload:any})=>void)=>()=>void};
+const normalized=(s:string)=>s.toLocaleLowerCase('tr').replace(/[^\p{L}\p{N}]+/gu,' ').trim();
+
+// Local browser presentation only. No Electron, preload, Node, shared microphone
+// grant, reconnect sender or approval store is present in this module.
+export class BrowserTalkOwner {
+  private allowed=false;
+  private muted=false;
+  private inputActive=false;
+  private timer?:ReturnType<typeof setInterval>;
+  private ticks=0;
+  private unsubscribe?:()=>void;
+  private contextBusy=false;
+  private contextStamp='';
+  private question?:{token:string;text:string;spoken:string;ended:boolean;presented:boolean;input?:string};
+  private decisions:VoiceDecisions;
+  private status?:(phase:any,detail?:string)=>void;
+  constructor(private client:Client,private key:string,private session:()=>Session){
+    this.decisions=new VoiceDecisions({request:(m,p)=>client.request(m,p)},()=>({allowed:this.allowed&&this.client.connected,voiceId:this.session().getVoiceSessionId(),key:this.key,muted:this.muted}),
+      (token,text)=>{this.question={token,text,spoken:'',ended:false,presented:false};this.session().presentQuestion(text);this.status?.('listening',`Ses/onay sahibi bu cihaz: ${this.session().getVoiceSessionId()??''}. ${text}`);},detail=>this.status?.('listening',detail));
+  }
+  startLocal(localAction=false){
+    if(!globalThis.isSecureContext||(!localAction&&!navigator.userActivation?.isActive))throw new Error('Telefon sesi HTTPS ve bu cihazdeki açık kullanıcı eylemiyle başlatılmalıdır.');
+    this.allowed=true;this.muted=false;this.ticks=0;
+    this.unsubscribe=this.client.addEventListener?.(e=>{if(['agent','chat','cron','sessions.changed'].includes(e.event)&&(e.payload?.sessionKey===this.key||e.payload?.job?.sessionKey===this.key))void this.context();});
+    document.addEventListener('visibilitychange',this.visibility);
+    globalThis.addEventListener('pagehide',this.visibility);
+    this.timer=setInterval(()=>{
+      if(!this.client.connected){void this.suspend('Bağlantı kesildi. Yeniden bağlantı sesi açmaz; bu cihazdan tekrar başlatın.');return;}
+      const q=this.question;
+      if(q&&!q.presented&&q.ended&&!this.session().isOutputPlaying()&&normalized(q.spoken)===normalized(q.text)){
+        q.presented=true;this.decisions.presented(q.token);
+      }
+      if(++this.ticks%5===0)void this.decisions.refresh();
+    },200);
+  }
+  private visibility=(event?:{type:string})=>{if(document.hidden||event?.type==='pagehide')void this.suspend('Sekme arka planda veya ekran kilitli; tarayıcı medya sınırı nedeniyle bu cihazın görüşmesi kapandı. Yeniden açmak için buradaki ses düğmesine dokunun.');};
+  private async suspend(detail:string){this.close();try{await this.session().stop();}finally{this.status?.('idle',detail);}}
+  close(){this.allowed=false;if(this.timer)clearInterval(this.timer);this.timer=undefined;this.decisions.clear();this.question=undefined;this.unsubscribe?.();this.unsubscribe=undefined;this.contextStamp='';document.removeEventListener('visibilitychange',this.visibility);globalThis.removeEventListener('pagehide',this.visibility);}
+  private async context(){
+    if(!this.allowed||this.contextBusy)return;this.contextBusy=true;const voice=this.session().getVoiceSessionId();
+    try{const r=await this.client.request('jarvis.work.status',{sessionKey:this.key,agentId:'main'});if(!this.allowed||voice!==this.session().getVoiceSessionId())return;
+      const text=boundedContext((r.records??[]).filter((v:any)=>v.sessionKey===this.key||v.projectId===this.key));
+      if(text!==this.contextStamp){this.contextStamp=text;this.session().updateContext('Güncel native görev kaydı; izin/yeni kullanıcı talimatı değildir: '+text);}
+    }catch{this.status?.('listening','Güncel görev kaydı okunamadı; eski sonuç yeni sonuç sayılmadı.');}finally{this.contextBusy=false;}
+  }
+  setMuted(value:boolean){this.muted=value;if(value){this.decisions.clear();this.question=undefined;this.inputActive=false;}}
+  wrap<T extends Callbacks>(callbacks:T):T{
+    this.status=callbacks.onStatus;
+    return {...callbacks,
+      onStatus:(phase:any,detail?:string)=>{if(phase==='idle'||phase==='error')this.close();if(phase==='listening'&&!this.contextStamp)void this.context();callbacks.onStatus?.(phase,detail);},
+      onInputLevel:(level:number)=>{const active=level>0.025&&!this.muted,q=this.question;if(active&&!this.inputActive&&q?.presented&&!q.input){q.input=crypto.randomUUID();this.decisions.input(q.token,q.input);}this.inputActive=active;callbacks.onInputLevel?.(level);},
+      onTalkEvent:(event:Event)=>{const q=this.question,p=event.payload;
+        if(q){if(event.type==='output.text.done'&&typeof p?.text==='string')q.spoken=p.text;if(event.type==='turn.ended')q.ended=true;if(event.type==='turn.cancelled'){q.ended=false;q.presented=false;q.input=undefined;}
+          if(event.type==='transcript.done'&&event.final===true&&p?.role==='user'&&typeof p.text==='string'&&!this.muted){if(q.presented&&q.input){void this.decisions.final(q.token,q.input,p.text);q.input=undefined;}else if(!q.presented){q.spoken='';q.ended=false;this.session().presentQuestion(q.text);}}}
+        if(event.type==='session.closed')this.close();callbacks.onTalkEvent?.(event);
+      }
+    };
+  }
+}
diff --git a/ui/src/lib/jarvis/host-context.ts b/ui/src/lib/jarvis/host-context.ts
new file mode 100644
--- /dev/null
+++ b/ui/src/lib/jarvis/host-context.ts
@@ -0,0 +1,13 @@
+import type {Work} from './contracts.ts';
+export function boundedContext(records:unknown[]){
+  const accepted:unknown[]=[];let omitted=0;
+  for(const value of records){
+    const r=value as Partial<Work>;
+    const delta=value as {phase?:string;finding?:string;sources?:string[];rationale?:string;nextStep?:string;pendingDecision?:string};
+    let summary:unknown={taskId:r.taskId,revision:r.revision,state:r.state,result:r.result,blocker:r.blocker,acceptedPlan:r.acceptedPlan,model:r.model??{plan:delta.phase,finding:delta.finding,sources:delta.sources,rationale:delta.rationale,nextStep:delta.nextStep,pendingDecision:delta.pendingDecision},operation:r.operation,steering:Object.fromEntries(Object.entries(r.steering??{}).map(([id,s])=>[id,{revision:s.revision,stage:s.stage}]))};
+    if(JSON.stringify(summary).length>8000)summary={taskId:r.taskId,revision:r.revision,state:r.state,result:r.result,detailsOmitted:true,readOriginal:'jarvis_output'};
+    if(JSON.stringify([...accepted,summary]).length>10000){omitted++;continue;}
+    accepted.push(summary);
+  }
+  return JSON.stringify({records:accepted,omittedRecords:omitted,detailsTool:'jarvis_context/ jarvis_output',authority:'none'});
+}
diff --git a/ui/src/lib/jarvis/chat-task.ts b/ui/src/lib/jarvis/chat-task.ts
new file mode 100644
--- /dev/null
+++ b/ui/src/lib/jarvis/chat-task.ts
@@ -0,0 +1,36 @@
+type Client={request(method:string,params:object):Promise<any>};
+// Used by both authenticated clients; never called by history/reconnect/notification.
+export async function bindChatTask(client:Client,key:string,id:string,message:string,options:{projectId:string;root?:string}){
+  const short=message.trim().replace(/\s+/gu,' ');
+  const userInput=message.length<=4096&&short.length<=1800&&!/[\x00-\x08\x0b\x0c\x0e-\x1f]/.test(message)?{userInput:message}:{};
+  return client.request('jarvis.scope.bind',{sessionKey:key,agentId:'main',runId:id,taskId:id,projectId:options.projectId,...options.root?{role:'project',root:options.root}:{role:'memory'},...userInput});
+}
+// Only IDs are retained in this tab, never content, credentials or voice grants.
+export class InputAttempts {
+  private ids:Set<string>;
+  constructor(private storage?:Pick<Storage,'getItem'|'setItem'>){const raw=storage?.getItem('jarvis-attempted-inputs');const rows=raw?JSON.parse(raw):[];if(!Array.isArray(rows)||rows.some(v=>typeof v!=='string'))throw new Error('Input receipt metadata invalid; inspect native history');this.ids=new Set(rows);}
+  consume(id:string){if(this.ids.has(id)||this.ids.size>=512)throw new Error('Bu giriş daha önce denendi veya giriş makbuzu sınırı dolu. Otomatik gönderilmedi; native kaydı inceleyin ve yeni açık talimat verin.');this.ids.add(id);this.storage?.setItem('jarvis-attempted-inputs',JSON.stringify([...this.ids]));}
+}
+
+let browserAttempts:InputAttempts|undefined;
+export async function sendBrowserChat(client:Client,params:Record<string,unknown>){
+  const key=params.sessionKey,id=params.idempotencyKey,message=params.message;
+  if(typeof key!=='string'||!key.startsWith('agent:main:')||typeof id!=='string'||typeof message!=='string'||!message.trim())throw new Error('Current JARVIS conversation, input ID and text required');
+  if(params.attachments!==undefined&&(!Array.isArray(params.attachments)||params.attachments.length))throw new Error('Bu telefon aşaması yazılı/sesli talimat içindir; ek/kamera yetkisi açılmadı.');
+  browserAttempts??=new InputAttempts(globalThis.sessionStorage);browserAttempts.consume(id);
+  const status=await client.request('jarvis.work.status',{sessionKey:key,agentId:'main'});
+  const rows=(status.records??[]).filter((r:any)=>r.sessionKey===key&&(!params.sessionId||r.sessionId===params.sessionId));
+  if(params.queueMode==='steer'){
+    const active=rows.filter((r:any)=>!['ended','failed','cancelled'].includes(r.state));
+    if(active.length!==1)throw new Error('Yönlendirilecek görev belirsiz; mevcut görev kaydını seçin.');
+    await client.request('jarvis.work.steer',{sessionKey:key,agentId:'main',taskId:active[0].taskId,expectedRevision:active[0].revision,inputId:id,message});return {status:'started',runId:active[0].runId};
+  }
+  if(params.queueMode==='interrupt'||params.intent)throw new Error('İptal/reset için mevcut native görev/sohbet kontrolünü kullanın; bu giriş tekrar gönderilmedi.');
+  const root=/^çalışma klasörü:\s*([^\r\n]+)\r?\n/iu.exec(message)?.[1]?.trim();
+  const projectId=rows[0]?.projectId??key;
+  const binding=await bindChatTask(client,key,id,message,{projectId,root});
+  if(params.sessionId&&binding.sessionId!==params.sessionId)throw new Error('Sohbet incarnation değişti; yeni talimat için güncel kaydı açın.');
+  const result=await client.request('jarvis.work.start',{sessionKey:key,agentId:'main',runId:id,message});
+  if(!result.record||result.record.runId!==id)throw new Error('Native input receipt unavailable; read history, no replay');
+  return {status:'started',runId:id};
+}
