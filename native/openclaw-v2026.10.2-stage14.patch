diff --git a/src/config/sessions/session-raw-retention.kernel.ts b/src/config/sessions/session-raw-retention.kernel.ts
new file mode 100644
index 00000000..f82c78f9
--- /dev/null
+++ b/src/config/sessions/session-raw-retention.kernel.ts
@@ -0,0 +1,564 @@
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { sql } from "kysely";
+import {
+  executeSqliteQuerySync,
+  executeSqliteQueryTakeFirstSync,
+  getNodeSqliteKysely,
+} from "../../infra/kysely-sync.js";
+import type { OpenClawAgentDatabase } from "../../state/openclaw-agent-db.js";
+import type { DB } from "../../state/openclaw-agent-db.generated.js";
+import { readSessionEntryRow } from "./session-accessor.sqlite-entry-store.js";
+import { getSessionKysely } from "./session-accessor.sqlite-scope.js";
+import { readTranscriptGenerationInTransaction } from "./session-accessor.sqlite-transcript-state.js";
+import { updateSqliteTranscriptEventJsonInTransaction } from "./session-accessor.sqlite-transcript-store.js";
+import {
+  decodeSessionArchiveBytesBounded,
+  encodeSessionArchiveContent,
+  invalidateMaterializedSessionArchiveReadCache,
+} from "./archive-compression.js";
+import {
+  hashSessionArchiveBytes,
+  publishEncodedSessionTranscriptArchive,
+  resolveRegisteredSqliteTranscriptArchiveName,
+} from "./session-accessor.sqlite-archive-artifact.js";
+import { resolveSessionArtifactDirectory } from "./paths.js";
+import {
+  decodeSessionColdRecords,
+  encodeSessionColdRecords,
+  resolveSessionColdArchivePath,
+  type SessionColdRecord,
+} from "./session-cold-storage-codec.js";
+import { readSessionColdTranscript } from "./session-cold-storage-state.js";
+import {
+  RAW_RETENTION_BATCH_SIZE,
+  RAW_RETENTION_MAX_EVENT_BYTES,
+  RAW_RETENTION_MS,
+  planRawRetention,
+} from "./session-raw-retention-plan.js";
+import { deleteSessionTranscriptFtsRowsInTransaction } from "./session-transcript-fts.js";
+import { transcriptEventJsonSql } from "./transcript-payload.js";
+
+export type RawRetentionTargetKind = "active" | "cold" | "lifecycle" | "cleanup";
+export type RawRetentionCursor = {
+  targetKind: RawRetentionTargetKind;
+  sessionId: string;
+  generation: string;
+  archiveName?: string;
+};
+export type RawRetentionTarget = RawRetentionCursor & { sessionKey: string };
+
+export type RawRetentionRequest = {
+  sessionKey: string;
+  sessionId: string;
+  targetKind?: RawRetentionTargetKind;
+  generation?: string;
+  archiveName?: string;
+  storePath?: string;
+  nowMs: number;
+  afterSeq?: number;
+  mode: "preview" | "apply";
+  expectedPreviewHash?: string;
+};
+export type RawRetentionResult = {
+  removedMessages: number;
+  eligibleMessages: number;
+  scannedRows: number;
+  nextAfterSeq: number;
+  hasMore: boolean;
+  previewHash: string;
+  generation?: string;
+  blockedScopes: string[];
+  nextDueAtMs?: number;
+};
+
+export type RawRetentionWindows = {
+  windows: RawRetentionTarget[];
+  nextCursor?: RawRetentionCursor;
+};
+
+/** Bounded keyset inventory over active, cold, lifecycle, and recovery-file owners. */
+export function listRawRetentionWindowsInDatabase(
+  database: OpenClawAgentDatabase,
+  input: { afterCursor?: RawRetentionCursor },
+): RawRetentionWindows {
+  const cursor = input.afterCursor;
+  if (
+    cursor &&
+    (!['active', 'cold', 'lifecycle', 'cleanup'].includes(cursor.targetKind) ||
+      typeof cursor.sessionId !== "string" ||
+      typeof cursor.generation !== "string" ||
+      (cursor.archiveName !== undefined && typeof cursor.archiveName !== "string"))
+  ) {
+    throw new Error("Invalid raw retention inventory cursor");
+  }
+  // sqlite-allow-raw: four owner indexes feed one bounded keyset page; no payload bytes are read.
+  const rows = database.db
+    .prepare(
+      `WITH targets AS (
+         SELECT 'active' AS target_kind, session_id, session_key,
+                COALESCE(generation, '') AS generation, '' AS archive_name
+           FROM session_windows
+           LEFT JOIN transcript_rewrite_watermarks USING (session_id)
+         UNION ALL
+         SELECT 'cold', cold.session_id, COALESCE(window.session_key, ''), cold.generation, ''
+           FROM session_transcript_cold_archives AS cold
+           LEFT JOIN session_windows AS window USING (session_id)
+         UNION ALL
+         SELECT 'lifecycle', session_id, session_key, generation, ''
+           FROM session_transcript_archives
+         UNION ALL
+         SELECT 'cleanup', session_id, session_key, generation, archive_name
+           FROM session_transcript_raw_retention_files
+       )
+       SELECT target_kind AS targetKind, session_id AS sessionId,
+              session_key AS sessionKey, generation, archive_name AS archiveName
+         FROM targets
+        WHERE (target_kind, session_id, generation, archive_name) > (?, ?, ?, ?)
+        ORDER BY target_kind, session_id, generation, archive_name
+        LIMIT 8`,
+    )
+    .all(
+      cursor?.targetKind ?? "",
+      cursor?.sessionId ?? "",
+      cursor?.generation ?? "",
+      cursor?.archiveName ?? "",
+    ) as unknown as (RawRetentionTarget & { archiveName: string })[];
+  return {
+    windows: rows.map(({ archiveName, ...row }) => ({
+      ...row,
+      ...(archiveName ? { archiveName } : {}),
+    })),
+    ...(rows.length === 8
+      ? {
+          nextCursor: {
+            targetKind: rows.at(-1)!.targetKind,
+            sessionId: rows.at(-1)!.sessionId,
+            generation: rows.at(-1)!.generation,
+            ...(rows.at(-1)!.archiveName ? { archiveName: rows.at(-1)!.archiveName } : {}),
+          },
+        }
+      : {}),
+  };
+}
+
+const ARCHIVE_MAX_BYTES = 64 * 1024 * 1024;
+const FILE_CLEANUP_BATCH_SIZE = 4;
+const digest = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex");
+
+type LifecycleArchive = {
+  session_id: string;
+  generation: string;
+  session_key: string;
+  reason: "deleted" | "reset";
+  encoding: "identity" | "zstd";
+  archive_blob: Uint8Array;
+  archive_sha256: string;
+  archive_name: string;
+  created_at: number;
+  published_at: number | null;
+};
+
+type ColdArchive = {
+  session_id: string;
+  generation: string;
+  archive_name: string;
+  archive_sha256: string;
+  event_count: number;
+  raw_bytes: number;
+  archive_bytes: number;
+  last_seq: number;
+  storage: "file" | "sqlite";
+  archive_blob: Uint8Array | null;
+};
+
+function verifyRawArchiveFile(filePath: string, expectedHash?: string): Buffer | undefined {
+  let stat: fs.Stats;
+  try {
+    stat = fs.lstatSync(filePath);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+    throw error;
+  }
+  if (!stat.isFile() || stat.isSymbolicLink() || stat.nlink !== 1) {
+    throw new Error("Raw archive file is linked or is not a regular single-owner file");
+  }
+  const bytes = fs.readFileSync(filePath);
+  if (expectedHash && digest(bytes) !== expectedHash) {
+    throw new Error("Raw archive file hash changed; cleanup is blocked");
+  }
+  return bytes;
+}
+
+function rawArchivePath(storePath: string, ownerType: "cold" | "lifecycle", name: string): string {
+  if (ownerType === "cold") return resolveSessionColdArchivePath(storePath, name);
+  if (!name || path.basename(name) !== name || name === "." || name === "..") {
+    throw new Error("Invalid lifecycle archive name");
+  }
+  const directory = path.resolve(resolveSessionArtifactDirectory(storePath));
+  const target = path.resolve(directory, name);
+  if (path.dirname(target) !== directory) throw new Error("Lifecycle archive escaped its owner directory");
+  return target;
+}
+
+function insertPendingRawArchiveFile(
+  database: OpenClawAgentDatabase,
+  input: { ownerType: "cold" | "lifecycle"; sessionId: string; sessionKey: string; generation: string; archiveName: string; archiveSha256: string; nowMs: number },
+): void {
+  // sqlite-allow-raw: durable exact-file recovery identity, committed with the new archive pointer.
+  database.db
+    .prepare(
+      `INSERT OR IGNORE INTO session_transcript_raw_retention_files
+       (owner_type, session_id, session_key, generation, archive_name, archive_sha256, created_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    )
+    .run(input.ownerType, input.sessionId, input.sessionKey, input.generation, input.archiveName, input.archiveSha256, input.nowMs);
+  const row = database.db
+    .prepare(
+      `SELECT session_id, session_key, generation, archive_sha256
+         FROM session_transcript_raw_retention_files
+        WHERE owner_type = ? AND archive_name = ?`,
+    )
+    .get(input.ownerType, input.archiveName) as
+      | { session_id: string; session_key: string; generation: string; archive_sha256: string }
+      | undefined;
+  if (
+    !row || row.session_id !== input.sessionId || row.session_key !== input.sessionKey ||
+    row.generation !== input.generation || row.archive_sha256 !== input.archiveSha256
+  ) {
+    throw new Error("Pending raw archive cleanup identity collided");
+  }
+}
+
+function reconcilePendingRawArchiveFile(
+  database: OpenClawAgentDatabase,
+  input: RawRetentionRequest,
+): string[] {
+  if (!input.storePath || !input.archiveName) return ["raw-archive-cleanup-owner-unavailable"];
+  // sqlite-allow-raw: select only the one keyset-inventoried cleanup record.
+  const pending = database.db
+    .prepare(
+      `SELECT owner_type, session_id, session_key, generation, archive_name, archive_sha256
+         FROM session_transcript_raw_retention_files
+        WHERE owner_type IN ('cold', 'lifecycle') AND session_id = ? AND generation = ? AND archive_name = ?
+        LIMIT 1`,
+    )
+    .get(input.sessionId, input.generation ?? "", input.archiveName) as
+      | { owner_type: "cold" | "lifecycle"; session_id: string; session_key: string; generation: string; archive_name: string; archive_sha256: string }
+      | undefined;
+  if (!pending || pending.session_key !== input.sessionKey) return ["raw-archive-cleanup-identity-changed"];
+  const db = getNodeSqliteKysely<DB>(database.db);
+  const references = pending.owner_type === "cold"
+    ? executeSqliteQueryTakeFirstSync(database.db, db.selectFrom("session_transcript_cold_archives").select("session_id").where("archive_name", "=", pending.archive_name))
+    : executeSqliteQueryTakeFirstSync(database.db, db.selectFrom("session_transcript_archives").select("session_id").where("archive_name", "=", pending.archive_name));
+  if (references) return ["raw-archive-file-still-canonical"];
+  try {
+    const filePath = rawArchivePath(input.storePath, pending.owner_type, pending.archive_name);
+    const bytes = verifyRawArchiveFile(filePath, pending.archive_sha256);
+    if (bytes) fs.unlinkSync(filePath);
+    if (pending.owner_type === "lifecycle") invalidateMaterializedSessionArchiveReadCache(filePath);
+    // sqlite-allow-raw: delete the journal only after verified removal (or confirmed absence).
+    database.db
+      .prepare(
+        `DELETE FROM session_transcript_raw_retention_files
+          WHERE owner_type = ? AND session_id = ? AND generation = ? AND archive_name = ? AND archive_sha256 = ?`,
+      )
+      .run(pending.owner_type, pending.session_id, pending.generation, pending.archive_name, pending.archive_sha256);
+    return [];
+  } catch {
+    return ["raw-archive-file-removal-refused-or-unverifiable"];
+  }
+}
+
+function parseLifecycleArchive(archive: LifecycleArchive) {
+  if (archive.encoding !== "identity" && archive.encoding !== "zstd") throw new Error("Unknown lifecycle archive encoding");
+  if (digest(archive.archive_blob) !== archive.archive_sha256) throw new Error("Lifecycle archive failed canonical hash verification");
+  const content = decodeSessionArchiveBytesBounded(archive.archive_blob, archive.encoding === "zstd", ARCHIVE_MAX_BYTES);
+  const lines = content.split("\n");
+  while (lines.length && lines.at(-1) === "") lines.pop();
+  const header = lines[0] ? JSON.parse(lines[0]) : undefined;
+  if (!header || header.type !== "session" || header.id !== archive.session_id) throw new Error("Lifecycle archive header does not match its owner");
+  const rows = lines.slice(1).map((eventJson, index) => ({ seq: index + 1, eventJson }));
+  return { lines, rows };
+}
+
+function hasUnclassifiedEvents(rows: readonly { eventJson: string }[]) {
+  return rows.some(({ eventJson }) => {
+    const value: unknown = JSON.parse(eventJson);
+    return value !== null && typeof value === "object" && !Array.isArray(value) &&
+      (value as Record<string, unknown>).type !== "message" &&
+      (value as Record<string, unknown>).rawRetentionExpired !== true;
+  });
+}
+
+function maintainLifecycleArchive(
+  database: OpenClawAgentDatabase,
+  input: RawRetentionRequest,
+): RawRetentionResult {
+  const db = getNodeSqliteKysely<DB>(database.db);
+  const archive = executeSqliteQueryTakeFirstSync(
+    database.db,
+    db.selectFrom("session_transcript_archives").selectAll()
+      .where("session_id", "=", input.sessionId)
+      .where("generation", "=", input.generation ?? ""),
+  ) as LifecycleArchive | undefined;
+  if (!archive || archive.session_key !== input.sessionKey) throw new Error("Lifecycle archive generation is no longer owned by this chat");
+  const { lines, rows: allRows } = parseLifecycleArchive(archive);
+  const rows = allRows.filter((row) => row.seq > (input.afterSeq ?? -1)).slice(0, RAW_RETENTION_BATCH_SIZE);
+  const oversized = rows.filter((row) => Buffer.byteLength(row.eventJson) > RAW_RETENTION_MAX_EVENT_BYTES);
+  const plan = planRawRetention(
+    rows.filter((row) => Buffer.byteLength(row.eventJson) <= RAW_RETENTION_MAX_EVENT_BYTES),
+    input.nowMs - RAW_RETENTION_MS,
+  );
+  const previewHash = `lifecycle:${archive.session_id}:${archive.generation}:${archive.archive_sha256}:${plan.previewHash}`;
+  const blockedScopes: string[] = [];
+  if (hasUnclassifiedEvents(rows)) blockedScopes.push("custom-control-and-summary-raw-payloads");
+  if (oversized.length) blockedScopes.push("oversized-or-unmeasured-events");
+  if (plan.unresolvedMessages) blockedScopes.push("undated-or-unrecognized-message-events");
+  let removedMessages = 0;
+  if (input.mode === "apply") {
+    if (previewHash !== input.expectedPreviewHash) throw new Error("Raw retention preview changed; preview the archive batch again");
+    if (plan.updates.length) {
+      const bySeq = new Map(plan.updates.map((row) => [row.seq, row.eventJson]));
+      for (const [seq, eventJson] of bySeq) lines[seq] = eventJson;
+      const encoded = encodeSessionArchiveContent(`${lines.join("\n")}\n`);
+      if (encoded.bytes.byteLength > ARCHIVE_MAX_BYTES) throw new Error("Rewritten lifecycle archive exceeds the maintenance size limit");
+      const archiveSha256 = hashSessionArchiveBytes(encoded.bytes);
+      let archiveName = archive.archive_name;
+      let publishedAt = archive.published_at;
+      if (archive.published_at !== null && input.storePath) {
+        const directory = resolveSessionArtifactDirectory(input.storePath);
+        const oldPath = rawArchivePath(input.storePath, "lifecycle", archive.archive_name);
+        const oldBytes = verifyRawArchiveFile(oldPath, archive.archive_sha256);
+        const createdAt = Math.max(input.nowMs, archive.created_at + 1);
+        for (let attempt = 0; attempt < 10; attempt += 1) {
+          archiveName = resolveRegisteredSqliteTranscriptArchiveName({
+            createdAt: createdAt + attempt,
+            encoding: encoded.suffix ? "zstd" : "identity",
+            generation: archive.generation,
+            reason: archive.reason,
+            sessionId: archive.session_id,
+          });
+          const target = path.join(directory, archiveName);
+          const existing = verifyRawArchiveFile(target);
+          if (!existing || digest(existing) === archiveSha256) break;
+          archiveName = "";
+        }
+        if (!archiveName) throw new Error("Could not allocate a new lifecycle archive identity");
+        publishEncodedSessionTranscriptArchive({ archiveDirectory: directory, archiveName, bytes: encoded.bytes, sha256: archiveSha256 });
+        publishedAt = input.nowMs;
+        if (oldBytes) {
+          insertPendingRawArchiveFile(database, {
+            ownerType: "lifecycle", sessionId: archive.session_id, sessionKey: archive.session_key,
+            generation: archive.generation, archiveName: archive.archive_name,
+            archiveSha256: archive.archive_sha256, nowMs: input.nowMs,
+          });
+        }
+      } else if (archive.published_at !== null) {
+        throw new Error("Lifecycle archive export owner is unavailable; canonical data was not rewritten");
+      }
+      // sqlite-allow-raw: exact old hash/generation CAS couples the sanitized blob to the new export name.
+      const changed = database.db.prepare(
+        `UPDATE session_transcript_archives
+            SET archive_blob = ?, archive_sha256 = ?, archive_name = ?, encoding = ?, published_at = ?
+          WHERE session_id = ? AND generation = ? AND archive_sha256 = ?`,
+      ).run(encoded.bytes, archiveSha256, archiveName, encoded.suffix ? "zstd" : "identity", publishedAt,
+        archive.session_id, archive.generation, archive.archive_sha256);
+      if (Number(changed.changes) !== 1) throw new Error("Lifecycle archive changed before retention commit");
+      removedMessages = plan.updates.length;
+    }
+  }
+  return {
+    removedMessages,
+    eligibleMessages: plan.updates.length,
+    scannedRows: rows.length,
+    nextAfterSeq: rows.at(-1)?.seq ?? input.afterSeq ?? -1,
+    hasMore: rows.length === RAW_RETENTION_BATCH_SIZE,
+    previewHash,
+    generation: archive.generation,
+    blockedScopes,
+    ...(plan.nextDueAtMs === undefined ? {} : { nextDueAtMs: plan.nextDueAtMs }),
+  };
+}
+
+function updateColdRecordForTombstones(records: SessionColdRecord[], updates: readonly { seq: number; eventJson: string }[]): SessionColdRecord[] {
+  const bySeq = new Map(updates.map((row) => [row.seq, row.eventJson]));
+  const ids = new Set(updates.map((row) => String(JSON.parse(row.eventJson).id)));
+  return records.flatMap((record): SessionColdRecord[] => {
+    if (record.kind === "event" && bySeq.has(record.row.seq)) {
+      return [{ kind: "event", row: { ...record.row, event_json: bySeq.get(record.row.seq)! } }];
+    }
+    if (record.kind === "identity" && updates.some((row) => row.seq === record.row.seq)) {
+      return [{ kind: "identity", row: { ...record.row, event_type: "custom", message_idempotency_key: null } }];
+    }
+    if (record.kind === "active" && updates.some((row) => row.seq === record.row.event_seq)) {
+      return [{ kind: "active", row: { ...record.row, message_position: null, context_eligible: 0 } }];
+    }
+    if (record.kind === "fts" && record.row.message_id && ids.has(record.row.message_id)) return [];
+    if (record.kind === "index") return [{ kind: "index", row: { ...record.row, needs_rebuild: 1 } }];
+    return [record];
+  });
+}
+
+function maintainColdArchive(database: OpenClawAgentDatabase, input: RawRetentionRequest): RawRetentionResult {
+  const db = getNodeSqliteKysely<DB>(database.db);
+  const owner = executeSqliteQueryTakeFirstSync(database.db,
+    db.selectFrom("session_windows").select("session_key").where("session_id", "=", input.sessionId));
+  if (owner?.session_key !== input.sessionKey) throw new Error("Cold archive session owner changed");
+  const archive = executeSqliteQueryTakeFirstSync(database.db,
+    db.selectFrom("session_transcript_cold_archives").selectAll()
+      .where("session_id", "=", input.sessionId)
+      .where("generation", "=", input.generation ?? "")) as ColdArchive | undefined;
+  if (!archive) throw new Error("Cold archive generation is no longer present");
+  if (!input.storePath) throw new Error("Cold archive owner path is unavailable");
+  const archiveBytes = archive.storage === "sqlite"
+    ? Buffer.from(archive.archive_blob ?? [])
+    : verifyRawArchiveFile(resolveSessionColdArchivePath(input.storePath, archive.archive_name), archive.archive_sha256);
+  if (!archiveBytes || archiveBytes.byteLength !== archive.archive_bytes || digest(archiveBytes) !== archive.archive_sha256) {
+    throw new Error("Cold archive failed canonical size/hash verification");
+  }
+  const records = decodeSessionColdRecords(archiveBytes, archive);
+  const allRows = records.flatMap((record) => record.kind === "event" ? [{ seq: record.row.seq, eventJson: record.row.event_json }] : []);
+  const rows = allRows.filter((row) => row.seq > (input.afterSeq ?? -1)).slice(0, RAW_RETENTION_BATCH_SIZE);
+  const oversized = rows.filter((row) => Buffer.byteLength(row.eventJson) > RAW_RETENTION_MAX_EVENT_BYTES);
+  const plan = planRawRetention(rows.filter((row) => Buffer.byteLength(row.eventJson) <= RAW_RETENTION_MAX_EVENT_BYTES), input.nowMs - RAW_RETENTION_MS);
+  const previewHash = `cold:${archive.session_id}:${archive.generation}:${archive.archive_sha256}:${plan.previewHash}`;
+  const blockedScopes: string[] = [];
+  if (hasUnclassifiedEvents(rows)) blockedScopes.push("custom-control-and-summary-raw-payloads");
+  if (oversized.length) blockedScopes.push("oversized-or-unmeasured-events");
+  if (plan.unresolvedMessages) blockedScopes.push("undated-or-unrecognized-message-events");
+  let removedMessages = 0;
+  if (input.mode === "apply") {
+    if (previewHash !== input.expectedPreviewHash) throw new Error("Raw retention preview changed; preview the cold archive batch again");
+    if (plan.updates.length) {
+      const rewritten = updateColdRecordForTombstones(records, plan.updates);
+      const encoded = encodeSessionColdRecords(rewritten);
+      if (encoded.byteLength > ARCHIVE_MAX_BYTES) throw new Error("Rewritten cold archive exceeds the maintenance size limit");
+      const archiveSha256 = digest(encoded);
+      const archiveName = `${archiveSha256}.jsonl.zst`;
+      const eventRecords = rewritten.filter((record) => record.kind === "event");
+      const rawBytes = eventRecords.reduce((sum, record) => sum + Buffer.byteLength(record.row.event_json), 0) + Math.max(0, eventRecords.length - 1);
+      if (archive.storage === "file") {
+        const directory = path.dirname(resolveSessionColdArchivePath(input.storePath, archiveName));
+        publishEncodedSessionTranscriptArchive({ archiveDirectory: directory, archiveName, bytes: encoded, sha256: archiveSha256 });
+        insertPendingRawArchiveFile(database, {
+          ownerType: "cold", sessionId: archive.session_id, sessionKey: input.sessionKey,
+          generation: archive.generation, archiveName: archive.archive_name,
+          archiveSha256: archive.archive_sha256, nowMs: input.nowMs,
+        });
+      }
+      // sqlite-allow-raw: exact immutable archive identity CAS and derived-metadata update.
+      const changed = database.db.prepare(
+        `UPDATE session_transcript_cold_archives
+            SET archive_name = ?, archive_sha256 = ?, event_count = ?, raw_bytes = ?, archive_bytes = ?,
+                last_seq = ?, storage = ?, archive_blob = ?
+          WHERE session_id = ? AND generation = ? AND archive_sha256 = ?`,
+      ).run(archiveName, archiveSha256, eventRecords.length, rawBytes, encoded.byteLength,
+        eventRecords.at(-1)?.row.seq ?? -1, archive.storage, archive.storage === "sqlite" ? encoded : null,
+        archive.session_id, archive.generation, archive.archive_sha256);
+      if (Number(changed.changes) !== 1) throw new Error("Cold archive changed before retention commit");
+      removedMessages = plan.updates.length;
+    }
+  }
+  return {
+    removedMessages, eligibleMessages: plan.updates.length, scannedRows: rows.length,
+    nextAfterSeq: rows.at(-1)?.seq ?? input.afterSeq ?? -1,
+    hasMore: rows.length === RAW_RETENTION_BATCH_SIZE, previewHash,
+    generation: archive.generation, blockedScopes,
+    ...(plan.nextDueAtMs === undefined ? {} : { nextDueAtMs: plan.nextDueAtMs }),
+  };
+}
+
+/** Called only under the admitted writer transaction. It touches one source generation and at most 32 events. */
+export function maintainRawRetentionInDatabase(
+  database: OpenClawAgentDatabase,
+  input: RawRetentionRequest,
+): RawRetentionResult {
+  if (
+    !Number.isSafeInteger(input.nowMs) || input.nowMs < RAW_RETENTION_MS ||
+    !Number.isSafeInteger(input.afterSeq ?? -1) || (input.afterSeq ?? -1) < -1 ||
+    !input.sessionKey || !input.sessionId || !["preview", "apply"].includes(input.mode)
+  ) throw new Error("Invalid raw retention request");
+  const kind = input.targetKind ?? "active";
+  if (!["active", "cold", "lifecycle", "cleanup"].includes(kind)) throw new Error("Invalid raw retention owner kind");
+  if (kind === "cleanup") {
+    if (!input.archiveName) throw new Error("Raw archive cleanup name is required");
+    const pending = database.db.prepare(
+      `SELECT owner_type, session_id, session_key, generation, archive_name, archive_sha256
+         FROM session_transcript_raw_retention_files
+        WHERE session_id = ? AND generation = ? AND archive_name = ? LIMIT 1`,
+    ).get(input.sessionId, input.generation ?? "", input.archiveName) as
+      | { owner_type: "cold" | "lifecycle"; session_id: string; session_key: string; generation: string; archive_name: string; archive_sha256: string }
+      | undefined;
+    if (!pending || pending.session_key !== input.sessionKey) throw new Error("Raw archive cleanup identity changed");
+    const previewHash = `cleanup:${pending.owner_type}:${pending.session_id}:${pending.generation}:${pending.archive_name}:${pending.archive_sha256}`;
+    const blockedScopes = input.mode === "apply"
+      ? input.expectedPreviewHash === previewHash
+        ? reconcilePendingRawArchiveFile(database, input)
+        : (() => { throw new Error("Raw retention cleanup preview changed"); })()
+      : [];
+    return { removedMessages: 0, eligibleMessages: 1, scannedRows: 0, nextAfterSeq: -1, hasMore: false,
+      previewHash, generation: pending.generation, blockedScopes };
+  }
+  // Historical generations are immutable archive owners and may outlive their session node.
+  // The public maintenance admission already reserves the stable session key and rejects active work.
+  if (kind === "cold") return maintainColdArchive(database, input);
+  if (kind === "lifecycle") return maintainLifecycleArchive(database, input);
+  const current = readSessionEntryRow(database, input.sessionKey)?.entry;
+  if (current?.activeWriterRunId) throw new Error("Raw retention deferred: conversation has an active writer");
+
+  const db = getSessionKysely(database.db);
+  const window = executeSqliteQueryTakeFirstSync(database.db,
+    db.selectFrom("session_windows").select(["session_key", "session_id"])
+      .where("session_id", "=", input.sessionId));
+  if ((window?.session_key !== input.sessionKey || window.session_id !== input.sessionId) && current?.sessionId !== input.sessionId) {
+    throw new Error("Raw retention transcript ownership changed");
+  }
+  const generationBefore = readTranscriptGenerationInTransaction(database, input.sessionId);
+  if (input.generation !== undefined && input.generation !== (generationBefore ?? "")) {
+    throw new Error("Raw retention transcript generation changed; refresh the maintenance inventory");
+  }
+  const blockedScopes: string[] = [];
+  if (readSessionColdTranscript(database.db, input.sessionId)) {
+    throw new Error("Active transcript moved to cold storage; refresh the maintenance inventory");
+  }
+  const rows = executeSqliteQuerySync(database.db,
+    db.selectFrom("transcript_events").select([
+      "seq",
+      /* kysely-allow-raw: bound decoded maintenance payload bytes before crossing the worker boundary. */
+      sql<string | null>`CASE WHEN event_utf8_bytes <= ${RAW_RETENTION_MAX_EVENT_BYTES}
+        THEN ${transcriptEventJsonSql(database.db)} ELSE NULL END`.as("event_json"),
+    ]).where("session_id", "=", input.sessionId).where("seq", ">", input.afterSeq ?? -1)
+      .orderBy("seq", "asc").limit(RAW_RETENTION_BATCH_SIZE)).rows;
+  if (rows.some((row) => row.event_json === null)) blockedScopes.push("oversized-or-unmeasured-events");
+  const rawRows = rows.flatMap((row) => row.event_json === null ? [] : [{ seq: row.seq, eventJson: row.event_json }]);
+  if (hasUnclassifiedEvents(rawRows)) blockedScopes.push("custom-control-and-summary-raw-payloads");
+  const plan = planRawRetention(rawRows, input.nowMs - RAW_RETENTION_MS);
+  if (plan.unresolvedMessages > 0) blockedScopes.push("undated-or-unrecognized-message-events");
+  const generation = generationBefore;
+  const previewHash = `active:${input.sessionId}:${generation ?? "none"}:${plan.previewHash}`;
+  let removedMessages = 0;
+  if (input.mode === "apply") {
+    if (previewHash !== input.expectedPreviewHash) throw new Error("Raw retention preview changed; preview the batch again");
+    if (plan.updates.length) {
+      for (const update of plan.updates) {
+        executeSqliteQuerySync(database.db, db.updateTable("transcript_event_identities")
+          .set({ event_type: "custom", message_idempotency_key: null })
+          .where("session_id", "=", input.sessionId).where("seq", "=", update.seq));
+      }
+      updateSqliteTranscriptEventJsonInTransaction(database, input.sessionId, plan.updates);
+      deleteSessionTranscriptFtsRowsInTransaction(database.db, input.sessionId, {
+        messageIds: plan.updates.map((update) => String(JSON.parse(update.eventJson).id)),
+      });
+      removedMessages = plan.updates.length;
+    }
+  }
+  return {
+    removedMessages, eligibleMessages: plan.updates.length, scannedRows: rows.length,
+    nextAfterSeq: rows.at(-1)?.seq ?? input.afterSeq ?? -1,
+    hasMore: rows.length === RAW_RETENTION_BATCH_SIZE, previewHash,
+    generation: readTranscriptGenerationInTransaction(database, input.sessionId), blockedScopes,
+    ...(plan.nextDueAtMs === undefined ? {} : { nextDueAtMs: plan.nextDueAtMs }),
+  };
+}
