new file mode 100644
index 00000000..e90f76c7
--- /dev/null
+++ b/extensions/memory-core/src/memory-forget-selection.ts
@@ -0,0 +1,98 @@
+import path from "node:path";
+import { root } from "openclaw/plugin-sdk/memory-core-host-engine-fs";
+import { isFileMissingError } from "openclaw/plugin-sdk/memory-core-host-engine-storage";
+import { getMemoryWorkspaceMaintenance } from "./memory-workspace-files.js";
+import { hashMemoryContent } from "./short-term-promotion-memory-write.js";
+
+export type MemoryForgetSource = {
+  relativePath: string;
+  /** SHA-256 of the exact UTF-8 preimage; missing removed sources are retryable. */
+  expectedHash: string;
+  /** null removes a whole selected source; a rewrite preserves unrelated facts. */
+  content: string | null;
+};
+
+export async function readSelectiveMemoryPreimage(workspaceDir: string, relativePath: string) {
+  if (getMemoryWorkspaceMaintenance(workspaceDir)) {
+    throw new Error("Controlled-source forget currently requires a local workspace");
+  }
+  const files = await root(workspaceDir, { symlinks: "reject", hardlinks: "reject" });
+  return files.readText(relativePath);
+}
+
+export async function prepareMemoryForgetSources(
+  workspaceDir: string,
+  sources: readonly MemoryForgetSource[],
+) {
+  const paths = new Set<string>();
+  const rewrites = [];
+  for (const source of sources) {
+    const name = source.relativePath;
+    if (
+      !/^memory\/(?:records|current)\/[a-zA-Z0-9_./-]+\.md$/u.test(name) ||
+      path.posix.normalize(name) !== name ||
+      name.split("/").includes("..") ||
+      !/^[a-f0-9]{64}$/u.test(source.expectedHash) ||
+      paths.has(name) ||
+      (source.content !== null &&
+        (typeof source.content !== "string" || source.content.includes("\0")))
+    ) {
+      throw new Error(
+        "Selective forget requires unique controlled note paths and exact SHA-256 preimages",
+      );
+    }
+    paths.add(name);
+    const absolutePath = path.join(workspaceDir, ...name.split("/"));
+    let content: string;
+    try {
+      content = await readSelectiveMemoryPreimage(workspaceDir, name);
+    } catch (error) {
+      if (
+        isFileMissingError(error) &&
+        (error.code === "ENOENT" || error.code === "not-found") &&
+        source.content === null
+      )
+        continue;
+      throw error;
+    }
+    if (hashMemoryContent(content) !== source.expectedHash) {
+      // A previously committed rewrite is idempotent. Any other change requires a new preview.
+      if (source.content !== null && content === source.content) continue;
+      throw new Error(`Selective forget preimage changed: ${name}`);
+    }
+    if (source.content === content) {
+      throw new Error(`Selective forget rewrite must remove selected content: ${name}`);
+    }
+    rewrites.push({
+      absolutePath,
+      relativePath: name,
+      content: source.content ?? "",
+      remove: source.content === null,
+      expectedContent: content,
+    });
+  }
+  return { paths, rewrites };
+}
+
+/** Only exact structured source references select a promoted entry; never match fact text. */
+export function sourceSelectedPromotionKeys(content: string, paths: ReadonlySet<string>): string[] {
+  const lines = content.split("\n");
+  const keys: string[] = [];
+  for (let index = 0; index < lines.length; index++) {
+    const key = /^\s*<!--\s*openclaw-memory-promotion:([^\n]*?)\s*-->\s*$/u
+      .exec(lines[index]!)?.[1]
+      ?.trim();
+    if (!key) continue;
+    const row = lines[index + 1] ?? "";
+    if (
+      [...paths].some(
+        (source) =>
+          key.startsWith(`memory:${source}:`) ||
+          row.includes(`Source: ${source}#L`) ||
+          row.includes(`source=${source}:`),
+      )
+    )
+      keys.push(key);
+  }
+  return keys;
+}
