@@ -0,0 +1,25 @@
+import type { DatabaseSync } from "node:sqlite";
+import { readMemorySelectiveTombstones } from "./memory-selective-tombstones.js";
+
+type SourceRow = { path: string; source?: string; id?: string; text?: string; snippet?: string };
+
+/** Hide old indexed source revisions as soon as their durable tombstone commits. */
+export function suppressForgottenMemorySources<T extends SourceRow>(
+  db: DatabaseSync,
+  rows: readonly T[],
+  defaultSource: "memory" | "sessions" = "memory",
+): T[] {
+  const markers = readMemorySelectiveTombstones(db).filter((marker) => marker.kind === "source");
+  if (markers.length === 0 || rows.length === 0) return [...rows];
+  const forgotten = new Set(markers.map((marker) => `${marker.key}\0${marker.hash}`));
+  const paths = [...new Set(rows.filter((row) => (row.source ?? defaultSource) === "memory").map((row) => row.path))];
+  if (paths.length === 0) return [...rows];
+  const marks = paths.map(() => "?").join(",");
+  const current = db.prepare(`SELECT path, hash FROM memory_index_sources WHERE source = 'memory' AND path IN (${marks})`).all(...paths) as Array<{path:string;hash:string}>;
+  const hashes = new Map(current.map((row) => [row.path, row.hash]));
+  return rows.filter((row) => {
+    if ((row.source ?? defaultSource) !== "memory") return true;
+    const hash = hashes.get(row.path);
+    return !hash || !forgotten.has(`${row.path}\0${hash}`);
+  });
+}
diff --git a/extensions/memory-core/src/memory-selective-tombstones.ts b/extensions/memory-core/src/memory-selective-tombstones.ts
new file mode 100644
index 00000000..03b15bd7
--- /dev/null
+++ b/extensions/memory-core/src/memory-selective-tombstones.ts
@@ -0,0 +1,71 @@
+import type { DatabaseSync } from "node:sqlite";
+import {
+  executeSqliteQuerySync,
+  getNodeSqliteKysely,
+  tableExists,
+} from "openclaw/plugin-sdk/sqlite-worker-runtime";
+
+export type MemorySelectiveTombstone = { kind: "source" | "entry"; key: string; hash: string };
+type TombstoneDatabase = {
+  memory_selective_tombstones: MemorySelectiveTombstone & { created_at: number };
+};
+
+/**
+ * Memory Core's optional schema, admitted by Forget's existing SQLite writer,
+ * like memory_session_tombstones; it does not change the host schema version.
+ * Stores identities only. Hosts must fence rollback to a package lacking these checks.
+ */
+export function ensureMemorySelectiveTombstones(db: DatabaseSync): void {
+  db.exec(`CREATE TABLE IF NOT EXISTS memory_selective_tombstones (
+    kind TEXT NOT NULL, key TEXT NOT NULL, hash TEXT NOT NULL, created_at INTEGER NOT NULL,
+    PRIMARY KEY (kind, key, hash)
+  ) STRICT`);
+}
+
+export function recordMemorySelectiveTombstones(
+  db: DatabaseSync,
+  markers: readonly MemorySelectiveTombstone[],
+): void {
+  const query = getNodeSqliteKysely<TombstoneDatabase>(db);
+  for (const marker of markers) {
+    executeSqliteQuerySync(
+      db,
+      query
+        .insertInto("memory_selective_tombstones")
+        .values({ ...marker, created_at: Date.now() })
+        .onConflict((conflict) => conflict.columns(["kind", "key", "hash"]).doNothing()),
+    );
+  }
+}
+
+export function readMemorySelectiveTombstones(
+  db: DatabaseSync | undefined,
+): MemorySelectiveTombstone[] {
+  if (!db || !tableExists(db, "memory_selective_tombstones")) return [];
+  return executeSqliteQuerySync(
+    db,
+    getNodeSqliteKysely<TombstoneDatabase>(db)
+      .selectFrom("memory_selective_tombstones")
+      .select(["kind", "key", "hash"]),
+  ).rows;
+}
+
+export function isMemorySourceForgotten(
+  db: DatabaseSync,
+  relativePath: string,
+  hash: string,
+): boolean {
+  if (!tableExists(db, "memory_selective_tombstones")) return false;
+  return (
+    executeSqliteQuerySync(
+      db,
+      getNodeSqliteKysely<TombstoneDatabase>(db)
+        .selectFrom("memory_selective_tombstones")
+        .select("key")
+        .where("kind", "=", "source")
+        .where("key", "=", relativePath)
+        .where("hash", "=", hash)
+        .limit(1),
+    ).rows.length > 0
+  );
+}
