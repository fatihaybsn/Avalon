+} from "../../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../../state/openclaw-state-db.js";
+import { planRawRetention, RAW_RETENTION_MS } from "./session-raw-retention-plan.js";
+import { listRawRetentionWindowsInDatabase } from "./session-raw-retention.kernel.js";
+
+const tempDirs: string[] = [];
+afterEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+  cleanupTempDirs(tempDirs);
+});
+
+it("seeks historical window identities in bounded primary-key pages without decoding raw payloads", () => {
+  const future = planRawRetention(
+    [
+      {
+        seq: 0,
+        eventJson: JSON.stringify({
+          type: "message",
+          id: "recent",
+          parentId: null,
+          timestamp: RAW_RETENTION_MS * 10,
+          message: { role: "user", timestamp: 200, content: "recent" },
+        }),
+      },
+      {
+        seq: 1,
+        eventJson: JSON.stringify({
+          type: "message",
+          id: "later",
+          parentId: "recent",
+          timestamp: 300,
+          message: { role: "assistant", content: "later" },
+        }),
+      },
+      {
+        seq: 2,
+        eventJson: JSON.stringify({
+          type: "custom",
+          id: "tombstone",
+          parentId: "later",
+          rawRetentionExpired: true,
+          timestamp: 1,
+          data: {},
+        }),
+      },
+    ],
+    100,
+  );
+  expect(future.nextDueAtMs).toBe(200 + RAW_RETENTION_MS);
+  const env = { OPENCLAW_STATE_DIR: makeTempDir(tempDirs, "raw-retention-windows-") };
+  const database = openOpenClawAgentDatabase({ agentId: "main", env });
+  database.db
+    .prepare(
+      "INSERT INTO session_nodes (session_key, current_session_id, entry_json, updated_at) VALUES (?, ?, '{}', 1)",
+    )
+    .run("agent:main:stable-conversation", "history-09");
+  const insert = database.db.prepare(
+    "INSERT INTO session_windows (session_id, session_key, created_at, updated_at) VALUES (?, ?, 1, 1)",
+  );
+  for (let index = 0; index < 10; index++) {
+    insert.run(`history-${String(index).padStart(2, "0")}`, "agent:main:stable-conversation");
+  }
+  const first = listRawRetentionWindowsInDatabase(database, {});
+  expect(first.windows).toHaveLength(8);
+  expect(first.nextCursor).toEqual({ targetKind: "active", sessionId: "history-07", generation: "" });
+  expect(first.windows[0]).toEqual({
+    targetKind: "active",
+    generation: "",
+    sessionKey: "agent:main:stable-conversation",
+    sessionId: "history-00",
+  });
+  const second = listRawRetentionWindowsInDatabase(database, {
+    afterCursor: first.nextCursor,
+  });
+  expect(second.windows.map((row) => row.sessionId)).toEqual(["history-08", "history-09"]);
+  expect(second.nextCursor).toBeUndefined();
+  const plan = database.db
+    .prepare(
+      "EXPLAIN QUERY PLAN SELECT session_key, session_id FROM session_windows WHERE session_id > ? ORDER BY session_id ASC LIMIT 8",
+    )
