+import {
+  closeOpenClawAgentDatabasesForTest,
+  openOpenClawAgentDatabase,
+  runOpenClawAgentWriteTransaction,
+} from "../../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../../state/openclaw-state-db.js";
+import { decodeSessionArchiveBytesBounded } from "./archive-compression.js";
+import { resolveSessionArtifactDirectory } from "./paths.js";
+import {
+  decodeSessionColdRecords,
+  type SessionColdRecord,
+} from "./session-cold-storage-codec.js";
+import { resolveRegisteredSqliteTranscriptArchiveName, publishEncodedSessionTranscriptArchive } from "./session-accessor.sqlite-archive-artifact.js";
+import { listRawRetentionWindowsInDatabase, maintainRawRetentionInDatabase } from "./session-raw-retention.kernel.js";
+import { RAW_RETENTION_MS } from "./session-raw-retention-plan.js";
+
+const tempDirs: string[] = [];
+afterEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+  cleanupTempDirs(tempDirs);
+});
+
+const hash = (value: Uint8Array) => createHash("sha256").update(value).digest("hex");
+const msg = (id: string, role: "user" | "assistant", timestamp: number, content: string) => JSON.stringify({
+  type: "message", id, parentId: null, timestamp,
+  message: { role, timestamp, content },
+});
+
+it("selectively tombstones expired cold-generation messages and reconciles FTS while retaining recent and durable data", () => {
+  const env = { OPENCLAW_STATE_DIR: makeTempDir(tempDirs, "raw-retention-cold-") };
+  const options = { agentId: "main", env };
+  const database = openOpenClawAgentDatabase(options);
+  const sessionId = "cold-retention-session";
+  const sessionKey = "agent:main:cold-retention";
+  const oldEvent = msg("old-message", "user", 1, "cold-expired-secret");
+  const recentEvent = msg("recent-message", "assistant", RAW_RETENTION_MS * 2, "cold-recent-kept");
+  const customEvent = JSON.stringify({ type: "custom", id: "task", parentId: "old-message", customType: "task-record", data: { decision: "permanent-decision" } });
+  const records: SessionColdRecord[] = [
+    { kind: "header", version: 1, sessionId, generation: "cold-generation" },
+    { kind: "event", row: { seq: 1, event_json: oldEvent, created_at: 1 } },
+    { kind: "identity", row: { event_id: "old-message", seq: 1, event_type: "message", parent_id: null, message_idempotency_key: "old-key", created_at: 1 } },
+    { kind: "active", row: { active_position: 0, event_seq: 1, message_position: 0, context_eligible: 1 } },
+    { kind: "fts", row: { text: "cold-expired-secret", message_id: "old-message", role: "user", timestamp: 1 } },
+    { kind: "event", row: { seq: 2, event_json: recentEvent, created_at: RAW_RETENTION_MS * 2 } },
+    { kind: "event", row: { seq: 3, event_json: customEvent, created_at: 3 } },
+    { kind: "fts", row: { text: "cold-recent-kept", message_id: "recent-message", role: "assistant", timestamp: RAW_RETENTION_MS * 2 } },
+    { kind: "index", row: { indexed_seq: 3, leaf_event_id: "recent-message", needs_rebuild: 0, active_event_count: 3, active_message_count: 2, updated_at: 3 } },
+  ];
+  const plain = Buffer.from(`${records.map((record) => JSON.stringify(record)).join("\n")}\n`);
+  const bytes = zstdCompressSync(plain);
+  database.db.prepare(
+    "INSERT INTO session_nodes (session_key, current_session_id, entry_json, entry_valid, updated_at) VALUES (?, ?, ?, 1, 1)",
+  ).run(sessionKey, sessionId, JSON.stringify({ sessionId, updatedAt: 1 }));
+  database.db.prepare("INSERT INTO session_windows (session_id,session_key,created_at,updated_at) VALUES (?, ?, 1, 1)").run(sessionId, sessionKey);
+  database.db.prepare(
+    `INSERT INTO session_transcript_cold_archives
+     (session_id,generation,archive_name,archive_sha256,event_count,raw_bytes,archive_bytes,last_seq,archived_at,storage,archive_blob)
+     VALUES (?, ?, ?, ?, 3, ?, ?, 3, 1, 'sqlite', ?)`,
+  ).run(sessionId, "cold-generation", `${hash(bytes)}.jsonl.zst`, hash(bytes), Buffer.byteLength(oldEvent) + Buffer.byteLength(recentEvent) + Buffer.byteLength(customEvent) + 2, bytes.byteLength, bytes);
+
+  const base = { sessionId, sessionKey, targetKind: "cold" as const, generation: "cold-generation", storePath: database.path, nowMs: RAW_RETENTION_MS + 100, afterSeq: -1 };
+  const run = (request: Parameters<typeof maintainRawRetentionInDatabase>[1]) =>
+    runOpenClawAgentWriteTransaction((owner) => maintainRawRetentionInDatabase(owner, request), options);
+  const preview = run({ ...base, mode: "preview" });
+  expect(preview.eligibleMessages).toBe(1);
+  expect(preview.blockedScopes).toEqual(["custom-control-and-summary-raw-payloads"]);
+  const applied = run({ ...base, mode: "apply", expectedPreviewHash: preview.previewHash });
+  expect(applied.removedMessages).toBe(1);
+
+  const archive = database.db.prepare("SELECT * FROM session_transcript_cold_archives WHERE session_id = ?").get(sessionId) as {
+    session_id: string; generation: string; archive_blob: Uint8Array; archive_sha256: string; archive_bytes: number; event_count: number; raw_bytes: number; last_seq: number;
+  };
+  const retained = decodeSessionColdRecords(archive.archive_blob, archive);
+  const encoded = JSON.stringify(retained);
+  expect(encoded).not.toContain("cold-expired-secret");
+  expect(encoded).toContain("cold-recent-kept");
+  const durableEvent = retained.find((record): record is Extract<SessionColdRecord, { kind: "event" }> => record.kind === "event" && record.row.seq === 3);
+  expect(durableEvent).toBeDefined();
+  expect(JSON.parse(durableEvent!.row.event_json)).toMatchObject({ data: { decision: "permanent-decision" } });
+  expect(retained.find((record) => record.kind === "identity" && record.row.seq === 1)).toMatchObject({ kind: "identity", row: { event_type: "custom", message_idempotency_key: null } });
+  expect(retained.find((record) => record.kind === "active" && record.row.event_seq === 1)).toMatchObject({ kind: "active", row: { context_eligible: 0, message_position: null } });
+  expect(retained.find((record) => record.kind === "index")).toMatchObject({ kind: "index", row: { needs_rebuild: 1 } });
+  expect(listRawRetentionWindowsInDatabase(database, {}).windows.some((row) => row.targetKind === "cold" && row.generation === "cold-generation")).toBe(true);
+});
+
+it("rewrites lifecycle archive generations and removes only the hash-verified superseded export", () => {
+  const env = { OPENCLAW_STATE_DIR: makeTempDir(tempDirs, "raw-retention-lifecycle-") };
+  const options = { agentId: "main", env };
+  const database = openOpenClawAgentDatabase(options);
+  const sessionId = "deleted-retention-session";
+  const sessionKey = "agent:main:retained-chat";
+  const original = `${JSON.stringify({ type: "session", id: sessionId, timestamp: 1 })}\n${msg("deleted-old", "user", 1, "lifecycle-expired-secret")}\n${msg("deleted-recent", "assistant", RAW_RETENTION_MS * 2, "lifecycle-recent-kept")}\n`;
+  const originalBytes = Buffer.from(original);
+  const generation = "deleted-generation";
+  const oldName = resolveRegisteredSqliteTranscriptArchiveName({ createdAt: 10, encoding: "identity", generation, reason: "deleted", sessionId });
+  const archiveDirectory = resolveSessionArtifactDirectory(database.path);
+  publishEncodedSessionTranscriptArchive({ archiveDirectory, archiveName: oldName, bytes: originalBytes, sha256: hash(originalBytes) });
+  database.db.prepare(
+    `INSERT INTO session_transcript_archives
+     (session_id,generation,session_key,reason,encoding,archive_blob,archive_sha256,archive_name,created_at,published_at)
+     VALUES (?, ?, ?, 'deleted', 'identity', ?, ?, ?, 10, 10)`,
+  ).run(sessionId, generation, sessionKey, originalBytes, hash(originalBytes), oldName);
+
+  const base = { sessionId, sessionKey, targetKind: "lifecycle" as const, generation, storePath: database.path, nowMs: RAW_RETENTION_MS + 100, afterSeq: -1 };
+  const run = (request: Parameters<typeof maintainRawRetentionInDatabase>[1]) =>
+    runOpenClawAgentWriteTransaction((owner) => maintainRawRetentionInDatabase(owner, request), options);
+  const preview = run({ ...base, mode: "preview" });
+  const applied = run({ ...base, mode: "apply", expectedPreviewHash: preview.previewHash });
+  expect(applied.removedMessages).toBe(1);
+  expect(preview.blockedScopes).toEqual([]);
+  expect(fs.existsSync(path.join(archiveDirectory, oldName))).toBe(true); // durable cleanup journal owns the old copy until its own bounded item runs.
+
+  const cleanupWindow = listRawRetentionWindowsInDatabase(database, {}).windows.find((row) => row.targetKind === "cleanup" && row.archiveName === oldName)!;
+  expect(cleanupWindow).toBeDefined();
+  const cleanup = { ...cleanupWindow, storePath: database.path, nowMs: RAW_RETENTION_MS + 200, mode: "preview" as const };
+  const cleanupPreview = run(cleanup);
+  run({ ...cleanup, mode: "apply", expectedPreviewHash: cleanupPreview.previewHash });
+
+  const row = database.db.prepare("SELECT * FROM session_transcript_archives WHERE session_id = ? AND generation = ?").get(sessionId, generation) as {
+    session_id: string; generation: string; session_key: string; archive_blob: Uint8Array; archive_sha256: string; archive_name: string; encoding: "identity" | "zstd"; published_at: number;
+  };
+  expect(row.session_id).toBe(sessionId);
+  expect(row.generation).toBe(generation);
+  expect(row.session_key).toBe(sessionKey);
+  expect(fs.existsSync(path.join(archiveDirectory, oldName))).toBe(false);
+  const cleanContent = decodeSessionArchiveBytesBounded(row.archive_blob, row.encoding === "zstd", 64 * 1024 * 1024);
+  expect(cleanContent).not.toContain("lifecycle-expired-secret");
+  expect(cleanContent).toContain("lifecycle-recent-kept");
+  const cleanExport = fs.readFileSync(path.join(archiveDirectory, row.archive_name));
+  expect(decodeSessionArchiveBytesBounded(cleanExport, row.encoding === "zstd", 64 * 1024 * 1024)).not.toContain("lifecycle-expired-secret");
+});
