index 00000000..438667f6
--- /dev/null
+++ b/src/config/sessions/session-raw-retention-plan.ts
@@ -0,0 +1,85 @@
+import { createHash } from "node:crypto";
+
+export const RAW_RETENTION_MS = 30 * 24 * 60 * 60 * 1000;
+export const RAW_RETENTION_BATCH_SIZE = 32;
+export const RAW_RETENTION_MAX_EVENT_BYTES = 64 * 1024;
+
+type RecordValue = Record<string, unknown>;
+function record(value: unknown): RecordValue | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as RecordValue)
+    : undefined;
+}
+
+/** Retain only the navigation envelope, never arbitrary message metadata or reasoning. */
+export function expiredRawEvent(eventJson: string, cutoff: number): string | undefined {
+  const event = record(JSON.parse(eventJson));
+  const message = record(event?.message);
+  if (!event || event.type !== "message" || !message || event.rawRetentionExpired === true) {
+    return undefined;
+  }
+  if (!["user", "assistant", "toolResult", "tool"].includes(String(message.role))) {
+    return undefined;
+  }
+  // A missing or invalid original timestamp is an inventory gap, never permission to erase.
+  const timestamp = message.timestamp ?? event.timestamp;
+  const originalAt =
+    typeof timestamp === "string"
+      ? Date.parse(timestamp)
+      : typeof timestamp === "number"
+        ? timestamp
+        : NaN;
+  if (!Number.isFinite(originalAt) || originalAt < 0 || originalAt > cutoff) {
+    return undefined;
+  }
+  if (
+    typeof event.id !== "string" ||
+    !(event.parentId === null || typeof event.parentId === "string")
+  ) {
+    return undefined;
+  }
+  return JSON.stringify({
+    type: "custom",
+    id: event.id,
+    parentId: event.parentId,
+    timestamp: event.timestamp,
+    ...(event.appendMode === "side" ? { appendMode: "side" } : {}),
+    rawRetentionExpired: true,
+    customType: "openclaw.raw-retention-tombstone",
+    data: {},
+  });
+}
+
+export function planRawRetention(
+  rows: readonly { seq: number; eventJson: string }[],
+  cutoff: number,
+) {
+  let unresolvedMessages = 0;
+  let nextDueAtMs: number | undefined;
+  const updates = rows.flatMap((row) => {
+    const event = record(JSON.parse(row.eventJson));
+    const message = record(event?.message);
+    if (event?.type === "message" && event.rawRetentionExpired !== true) {
+      const timestamp = message?.timestamp ?? event.timestamp;
+      const at = typeof timestamp === "string" ? Date.parse(timestamp) : timestamp;
+      if (
+        !message ||
+        typeof at !== "number" ||
+        !Number.isFinite(at) ||
+        at < 0 ||
+        typeof event.id !== "string" ||
+        !(event.parentId === null || typeof event.parentId === "string") ||
+        !["user", "assistant", "toolResult", "tool"].includes(String(message.role))
+      ) {
+        unresolvedMessages += 1;
+      } else if (at > cutoff && Number.isSafeInteger(at + RAW_RETENTION_MS)) {
+        nextDueAtMs = Math.min(nextDueAtMs ?? Infinity, at + RAW_RETENTION_MS);
+      }
+    }
+    const eventJson = expiredRawEvent(row.eventJson, cutoff);
+    return eventJson === undefined ? [] : [{ seq: row.seq, eventJson }];
+  });
+  // The token binds exact raw bytes without returning those bytes to the caller.
+  const previewHash = createHash("sha256").update(JSON.stringify({ cutoff, rows })).digest("hex");
+  return { updates, previewHash, unresolvedMessages, nextDueAtMs };
+}
