+      database.db
+        .prepare(
+          "SELECT COUNT(*) AS n FROM session_transcript_fts_rows WHERE session_id = ? AND message_id = 'old'",
+        )
+        .get(scope.sessionId),
+    ).toMatchObject({ n: 0 });
+  });
+});
diff --git a/src/config/sessions/session-raw-retention.ts b/src/config/sessions/session-raw-retention.ts
new file mode 100644
index 00000000..74d0723c
--- /dev/null
+++ b/src/config/sessions/session-raw-retention.ts
@@ -0,0 +1,125 @@
+import { readDatabasePathIdentitySync } from "../../infra/sqlite-worker-identity.js";
+import { collectActiveSessionWorkAdmissions } from "../../sessions/session-lifecycle-admission.js";
+import { resolveOpenClawAgentSqlitePath } from "../../state/openclaw-agent-db.paths.js";
+import { publishTranscriptUpdate } from "./session-accessor.sqlite-events.js";
+import { withSessionEntryWorker } from "./session-accessor.sqlite-replacement-worker.js";
+import {
+  resolveSqliteTranscriptScope,
+  resolveSqliteScope,
+  toDatabaseOptions,
+} from "./session-accessor.sqlite-scope.js";
+import type { SessionTranscriptAccessScope } from "./session-accessor.types.js";
+import type {
+  RawRetentionRequest,
+  RawRetentionResult,
+  RawRetentionCursor,
+  RawRetentionWindows,
+} from "./session-raw-retention.kernel.js";
+
+export type { RawRetentionRequest, RawRetentionResult } from "./session-raw-retention.kernel.js";
+export type { RawRetentionCursor, RawRetentionTarget, RawRetentionWindows } from "./session-raw-retention.kernel.js";
+
+/** Bounded native inventory: caller stores the opaque lexical cursor in its existing work record. */
+export async function listRawRetentionWindows(params: {
+  agentId: string;
+  storePath?: string;
+  env?: NodeJS.ProcessEnv;
+  afterCursor?: RawRetentionCursor;
+  assertIdle: () => void;
+  signal: AbortSignal;
+}): Promise<RawRetentionWindows> {
+  const resolved = resolveSqliteScope({ ...params, sessionKey: "" });
+  const options = toDatabaseOptions(resolved);
+  const physical = readDatabasePathIdentitySync(resolveOpenClawAgentSqlitePath(options));
+  if (!physical.key.startsWith("file:")) {
+    throw new Error("Raw retention inventory requires an existing native file database");
+  }
+  const assertIdle = () => {
+    params.signal.throwIfAborted();
+    params.assertIdle();
+  };
+  assertIdle();
+  return withSessionEntryWorker(
+    { ...options, path: physical.canonicalPath },
+    physical.key.slice("file:".length),
+    assertIdle,
+    async (execution, source) => {
+      const result = await execution.runExisting(source, (worker) =>
+        worker.execute({
+          type: "session.rawRetention.windows",
+          input: { afterCursor: params.afterCursor },
+        }),
+      );
+      assertIdle();
+      if (!result) {
+        throw new Error("Raw retention inventory database disappeared before admission");
+      }
+      return result;
+    },
+    undefined,
+    undefined,
+    params.signal,
+  );
+}
+
+/** Trusted host maintenance API. assertIdle is revalidated by native transaction AND commit admission. */
+export async function maintainSessionRawRetention(params: {
+  scope: SessionTranscriptAccessScope;
+  request: Omit<RawRetentionRequest, "sessionKey" | "sessionId">;
+  assertIdle: () => void;
+  signal: AbortSignal;
+}): Promise<RawRetentionResult> {
+  const resolved = resolveSqliteTranscriptScope(params.scope);
+  const options = toDatabaseOptions(resolved);
+  const databasePath = resolveOpenClawAgentSqlitePath(options);
+  const physical = readDatabasePathIdentitySync(databasePath);
+  if (!physical.key.startsWith("file:")) {
+    throw new Error("Raw retention requires an existing native file database");
+  }
+  const assertIdle = () => {
+    params.signal.throwIfAborted();
+    params.assertIdle();
+    const admissions = collectActiveSessionWorkAdmissions();
+    for (const storePath of new Set([
+      params.scope.storePath,
+      resolved.ownerStorePath,
+      databasePath,
+      physical.canonicalPath,
+    ])) {
+      const active = storePath ? admissions.get(storePath) : undefined;
+      if (active?.has(resolved.sessionKey) || active?.has(resolved.sessionId)) {
+        throw new Error("Raw retention deferred: active native session work");
+      }
+    }
+  };
+  assertIdle();
+  const result = await withSessionEntryWorker(
+    { ...options, path: physical.canonicalPath },
+    physical.key.slice("file:".length),
+    assertIdle,
+    async (execution, source) => {
+      const value = await execution.runExisting(source, (worker) =>
+        worker.execute({
+          type: "session.rawRetention.batch",
+          input: {
+            ...params.request,
+            sessionKey: resolved.sessionKey,
+            sessionId: resolved.sessionId,
+            ...(params.scope.storePath ? { storePath: params.scope.storePath } : {}),
+          },
+        }),
+      );
+      if (!value) {
+        throw new Error("Raw retention database disappeared before admission");
+      }
+      return value;
+    },
+    undefined,
+    undefined,
+    params.signal,
+  );
+  if (result.removedMessages > 0) {
+    await publishTranscriptUpdate(params.scope);
+  }
+  return result;
+}
