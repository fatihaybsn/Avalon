+import { DatabaseSync } from "node:sqlite";
+import { describe, expect, it } from "vitest";
+import { ensureMemorySelectiveTombstones, recordMemorySelectiveTombstones } from "./memory-selective-tombstones.js";
+import { suppressForgottenMemorySources } from "./memory-selective-suppression.js";
+
+describe("selective forget search suppression", () => {
+  it("hides a tombstoned indexed source revision immediately and preserves other sources", () => {
+    const db = new DatabaseSync(":memory:");
+    db.exec("CREATE TABLE memory_index_sources (path TEXT, source TEXT, hash TEXT)");
+    db.prepare("INSERT INTO memory_index_sources VALUES (?, ?, ?)").run("memory/records/forgotten.md", "memory", "old-revision");
+    db.prepare("INSERT INTO memory_index_sources VALUES (?, ?, ?)").run("memory/records/kept.md", "memory", "kept-revision");
+    db.prepare("INSERT INTO memory_index_sources VALUES (?, ?, ?)").run("agent:main/session.jsonl", "sessions", "session-revision");
