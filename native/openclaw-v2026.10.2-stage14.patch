+     (owner_type,session_id,session_key,generation,archive_name,archive_sha256,created_at)
+     VALUES ('lifecycle', ?, ?, ?, ?, ?, 1)`,
+  ).run("deleted-session", "agent:main:deleted", "deleted-generation", "old-deleted.jsonl", "c".repeat(64));
