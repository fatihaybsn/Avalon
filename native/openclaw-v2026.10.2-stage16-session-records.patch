@@ -19,10 +19,55 @@ import type {
   SessionEntry,
   SessionInfoEntry,
   SessionLeafControl,
+  RawSourceProvenance,
 } from "./session-manager-types.js";
 import { withSessionManagerWrite } from "./session-manager-write-admission.js";
 import { warnSessionPersistenceDeprecation } from "./session-persistence-deprecation.js";
 
+const RAW_SOURCE_PROVENANCE_MAX_ENTRIES = 512;
+
+function timestampMs(value: unknown): number | undefined {
+  const at = typeof value === "string" ? Date.parse(value) : value;
+  return typeof at === "number" && Number.isFinite(at) && at >= 0 ? at : undefined;
+}
+
+function rawSourceProvenance(
+  entries: readonly SessionEntry[],
+  expectedEntryCount = entries.length,
+): RawSourceProvenance {
+  const sourceEntryIds = new Set<string>();
+  let oldestSourceTimestampMs = Number.POSITIVE_INFINITY;
+  let complete = entries.length > 0 && entries.length === expectedEntryCount;
+  for (const entry of entries) {
+    const prior =
+      entry.type === "compaction" || entry.type === "branch_summary"
+        ? entry.rawSourceProvenance
+        : undefined;
+    if (prior) {
+      for (const id of prior.sourceEntryIds) sourceEntryIds.add(id);
+      oldestSourceTimestampMs = Math.min(oldestSourceTimestampMs, prior.oldestSourceTimestampMs);
+      complete &&= prior.version === 1 && prior.complete && prior.sourceEntryIds.length > 0;
+      continue;
+    }
+    if (entry.type === "compaction" || entry.type === "branch_summary") complete = false;
+    sourceEntryIds.add(entry.id);
+    const messageAt = entry.type === "message" ? entry.message.timestamp : undefined;
+    const at = timestampMs(messageAt) ?? timestampMs(entry.timestamp);
+    if (at === undefined) complete = false;
+    else oldestSourceTimestampMs = Math.min(oldestSourceTimestampMs, at);
+  }
+  const ids = [...sourceEntryIds];
+  if (ids.length > RAW_SOURCE_PROVENANCE_MAX_ENTRIES) complete = false;
+  const boundedIds = ids.slice(0, RAW_SOURCE_PROVENANCE_MAX_ENTRIES);
+  if (!Number.isFinite(oldestSourceTimestampMs)) complete = false;
+  return {
+    version: 1,
+    sourceEntryIds: boundedIds,
+    oldestSourceTimestampMs: Number.isFinite(oldestSourceTimestampMs) ? oldestSourceTimestampMs : 0,
+    complete,
+  };
+}
