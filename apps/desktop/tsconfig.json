{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "experimentalDecorators": true,
    "useDefineForClassFields": false, "types": ["node"], "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts", "vendor/**/*.ts", "tests/*.test.ts", "vite.config.ts"],
  "exclude": ["vendor/talk/sources"]
}
