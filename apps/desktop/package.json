{
  "name": "jarvis-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "JARVIS OpenClaw masaüstü istemcisi",
  "engines": { "node": ">=24.16.0 <25 || >=26.1.0" },
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win --x64",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:voice": "node --experimental-transform-types --test tests/voice.test.mjs",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:dev": "node tests/electron-smoke.mjs --dev",
    "test:packaged": "node tests/electron-smoke.mjs --packaged",
    "test:live": "node tests/electron-live.mjs"
  },
  "dependencies": { "lit": "3.3.3", "ws": "8.22.0" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "allowScripts": { "electron": true, "esbuild": true },
  "build": {
    "appId": "local.jarvis.desktop",
    "productName": "JARVIS",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "vendor/openclaw/LICENSE", "vendor/openclaw/SOURCE.json", "THIRD_PARTY_NOTICES.md", "package.json"],
    "win": { "target": "nsis", "requestedExecutionLevel": "asInvoker", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "deleteAppDataOnUninstall": false
    }
  }
}
