{
  "id": "jarvis",
  "name": "JARVIS permissions",
  "description": "Host-bound task scopes and isolated official Tavily Advanced / native web_fetch",
  "activation": {
    "onStartup": true
  },
  "cliBackends": [
    "jarvis-opencode-memory",
    "jarvis-opencode-gui",
    "jarvis-opencode-main"
  ],
  "providers": [
    "jarvis-dream-google"
  ],
  "contracts": {
    "gatewayMethodDispatch": [
      "authenticated-request"
    ],
    "tools": [
      "jarvis_memory_search",
      "jarvis_memory_get",
      "jarvis_note_read",
      "jarvis_note_write",
      "jarvis_work_note",
      "jarvis_work_read",
      "jarvis_windows",
      "jarvis_recycle",
      "jarvis_document",
      "jarvis_draft",
      "jarvis_worker"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "openCodeFullAccess": { "type": "boolean" },
      "nativeRoot": {
        "type": "string"
      },
      "guiNode": {
        "type": "string"
      }
    }
  }
}
