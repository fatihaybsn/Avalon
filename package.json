{
  "name": "iris-hermes-voice",
  "productName": "Avalon",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "description": "A futuristic Gemini Live voice companion that delegates real work to Hermes.",
  "homepage": "https://github.com/fatihaybsn/Avalon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihaybsn/Avalon.git"
  },
  "bugs": {
    "url": "https://github.com/fatihaybsn/Avalon/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && node scripts/run-electron.mjs\"",
    "build": "tsc --noEmit && vite build && vite build --mode mobile",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "build:all": "npm run build",
    "setup:remote": "node scripts/setup-remote.mjs",
    "test:remote": "node --test test/remote.test.mjs",
    "test:remote-app": "npm run build && node scripts/test-remote-app.mjs --with-work",
    "test": "node --test test/*.test.mjs",
    "test:mobile-update-ui": "npm run build && node scripts/test-mobile-update-ui.mjs",
    "test:workspace-ui": "npm run build && node scripts/test-workspace-ui.mjs",
    "test:startup-ui": "npm run build && node scripts/test-startup-ui.mjs",
    "test:brain": "node scripts/test-brain-live.mjs --with-gemini",
    "test:research": "node scripts/test-research-live.mjs",
    "test:research-schedule": "node scripts/test-research-live.mjs --schedule",
    "test:research-ui": "npm run build && node scripts/test-research-ui.mjs",
    "test:window-layout": "npm run build && node scripts/test-window-layout-app.mjs",
    "test:brain-models": "node scripts/test-brain-models-live.mjs",
    "test:relay": "npm run build && node scripts/test-relay-app.mjs --with-work",
    "check:electron": "node scripts/check-electron.mjs",
    "verify": "npm run test && npm run check:electron && npm run build && npm run check:python",
    "test:live-search": "npm run build && node scripts/test-live-search.mjs",
    "test:live-sleep": "npm run build && node scripts/test-live-sleep-resume.mjs",
    "test:live-speech": "npm run build && node scripts/test-live-speech-standby.mjs",
    "test:hermes-wake": "npm run build && node scripts/test-live-hermes-wake.mjs",
    "soak": "node scripts/soak-runtime.mjs",
    "preview": "vite preview",
    "start": "npm run build && node scripts/run-electron.mjs --prod",
    "start:prod": "node scripts/run-electron.mjs --prod",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir && node scripts/sign-mac.mjs",
    "install:mac": "npm run package:mac && node scripts/install-mac.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "electron": "node scripts/run-electron.mjs",
    "setup:research": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-research.ps1",
    "sidecar": "node scripts/python-command.mjs sidecar",
    "check:python": "node scripts/python-command.mjs check",
    "brain:index": "node electron/brainIndex.mjs",
    "demo:vault": "node scripts/generate-demo-vault.mjs",
    "brain:skill-sync": "cp electron/brainIndex.mjs \"${HERMES_BRAIN_SKILL_DIR:-$HOME/.hermes/skills/memory/hermes-brain}/scripts/brain_embed_index.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/genai": "^2.10.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@ricky0123/vad-web": "^0.0.30",
    "@soundtouchjs/core": "2.1.1",
    "d3-force": "^3.0.0",
    "force-graph": "^1.51.4",
    "lucide-react": "1.21.0",
    "onnxruntime-web": "^1.27.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.61.1",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wait-on": "9.0.10",
    "workbox-precaching": "^7.4.1"
  },
  "build": {
    "appId": "app.iris.voice",
    "productName": "Avalon",
    "asarUnpack": [
      "automation/*.cjs",
      "automation/*.css",
      "automation/*.json",
      "automation/*.ps1",
      "automation/nodes/**",
      "sidecar/gpt_researcher_worker.py",
      "sidecar/brain_provider.py",
      "sidecar/research_scheduler.py"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-mobile/**",
      "electron/**",
      "automation/*.cjs",
      "automation/*.css",
      "automation/*.json",
      "automation/*.ps1",
      "automation/nodes/**",
      "!automation/node_modules/**",
      "sidecar/gpt_researcher_worker.py",
      "sidecar/brain_provider.py",
      "sidecar/research_scheduler.py",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Avalon uses the microphone for realtime voice conversation.",
        "NSCameraUsageDescription": "Avalon uses the camera for on-device hand gesture control."
      },
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
