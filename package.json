{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "openclaw": true
  },
  "scripts": {
    "check": "tsc --noEmit && npm --prefix apps/desktop run check",
    "test": "node --max-semi-space-size=4 --test --test-concurrency=1 tests/policy.test.mjs tests/reader.test.mjs tests/tavily.test.mjs tests/memory.test.mjs tests/dreaming.test.mjs tests/work.test.mjs tests/quick.test.mjs tests/gui-policy.test.mjs",
    "test:quick:gateway": "pwsh -NoProfile -File scripts/test-jarvis-policy.ps1 -QuickOnly",
    "test:quick:windows": "pwsh -NoProfile -File tests/windows-window.ps1",
    "test:work:gateway": "pwsh -NoProfile -File scripts/test-jarvis-policy.ps1 -WorkOnly",
    "test:gateway": "pwsh -NoProfile -File scripts/test-jarvis-policy.ps1",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:start": "npm --prefix apps/desktop start",
    "desktop:pack:win": "npm --prefix apps/desktop run pack:win",
    "test:desktop": "npm --prefix apps/desktop test",
    "test:desktop:electron": "npm --prefix apps/desktop run test:electron"
  },
  "dependencies": {
    "@opencode/client": "2.0.28",
    "openclaw": "2026.10.2"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
